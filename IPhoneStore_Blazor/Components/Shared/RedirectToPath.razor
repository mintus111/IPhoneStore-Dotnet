@inject NavigationManager Nav

@code {
    [Parameter, EditorRequired] public string Path { get; set; } = "/";

    protected override void OnInitialized()
    {
        var returnUrl = Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri));
        var target = Path.Contains("Login") ? $"{Path}?returnUrl=%2F{returnUrl}" : Path;
        Nav.NavigateTo(target, forceLoad: true);
    }
}
