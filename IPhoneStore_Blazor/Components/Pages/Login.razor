@page "/Account/Login"
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Http
@using IPhoneStore_Blazor.Models.Entities
@using IPhoneStore_Blazor.Services
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Đăng Nhập Khách Hàng - BomChelsea</PageTitle>

<div class="container py-4">
    @if (IsCheckout)
    {
        <!-- Stepper (Mockup 05) -->
        <div class="apple-stepper">
            <div class="stepper-line">
                <div class="stepper-line-progress" style="width: 40%;"></div>
            </div>
            <div class="stepper-step completed">
                <div class="step-circle">✓</div>
                <div class="step-label">Giỏ hàng</div>
            </div>
            <div class="stepper-step active">
                <div class="step-circle">2</div>
                <div class="step-label">Tài khoản</div>
            </div>
            <div class="stepper-step">
                <div class="step-circle">3</div>
                <div class="step-label">Thanh toán</div>
            </div>
            <div class="stepper-step">
                <div class="step-circle">4</div>
                <div class="step-label">Đặt hàng</div>
            </div>
        </div>
    }

    <div class="row justify-content-center g-4 my-2">
        <!-- Left: Bag Preview & Benefits -->
        <div class="col-lg-5">
            <div class="bg-white border rounded-3 p-4 shadow-sm h-100">
                @if (IsCheckout)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-primary bg-opacity-10 text-primary p-2 fw-bold">BƯỚC 2: XÁC THỰC</span>
                        <span class="text-secondary small">Bảo mật tài khoản</span>
                    </div>
                    <h3 class="fs-4 fw-bold text-dark mb-3">Đăng nhập tài khoản Apple Reseller</h3>
                    <p class="text-secondary mb-4" style="line-height:1.6;">
                        Đăng nhập để liên kết thiết bị của bạn với hệ thống bảo hành điện tử chính hãng Apple Care, tích lũy điểm BomChelsea Rewards và nhận thông báo lộ trình giao hàng qua SMS.
                    </p>

                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="d-flex align-items-start gap-3">
                            <div class="p-2 rounded-circle bg-light text-primary">
                                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">Tự động kích hoạt E-Warranty</div>
                                <div class="text-secondary small">Kích hoạt bảo hành điện tử qua số IMEI ngay khi nhận máy thành công.</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-3">
                            <div class="p-2 rounded-circle bg-light text-primary">
                                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">Theo dõi đơn hàng thời gian thực</div>
                                <div class="text-secondary small">Cập nhật lộ trình vận chuyển từ kho Apple đến tận tay bạn.</div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-secondary small">Chưa có tài khoản?</div>
                        <div class="fw-semibold text-dark small">Đăng ký siêu tốc chỉ trong 30 giây (không bắt buộc nhập địa chỉ ngay).</div>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-primary bg-opacity-10 text-primary p-2 fw-bold">APPLE BomChelsea</span>
                        <span class="text-secondary small">Trải nghiệm đồng bộ</span>
                    </div>
                    <h3 class="fs-4 fw-bold text-dark mb-3">Tài khoản Khách hàng</h3>
                    <p class="text-secondary mb-4" style="line-height:1.6;">
                        Đăng nhập bằng Tên đăng nhập, Email hoặc Số điện thoại để theo dõi đơn hàng của bạn trong thời gian thực, quản lý bảo hành điện tử chính hãng qua IMEI và tận hưởng các ưu đãi thành viên.
                    </p>

                    <div class="d-flex flex-column gap-3 mb-4">
                        <div class="d-flex align-items-start gap-3">
                            <div class="p-2 rounded-circle bg-light text-primary">
                                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">Định danh 1 ô duy nhất</div>
                                <div class="text-secondary small">Đăng nhập linh hoạt bằng Username, Email hoặc Số điện thoại.</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-3">
                            <div class="p-2 rounded-circle bg-light text-primary">
                                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">Bảo mật chuẩn Apple NIST</div>
                                <div class="text-secondary small">Hệ thống phòng vệ Brute-force 3 tầng ngăn chặn tuyệt đối dò quét tài khoản.</div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-secondary small">Chưa có tài khoản?</div>
                        <div class="fw-semibold text-dark small">Đăng ký dễ dàng chỉ với số điện thoại hoặc email của bạn.</div>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Login Form -->
        <div class="col-lg-5">
            <div class="bg-white border rounded-3 p-4 p-md-5 shadow-sm">
                <div class="text-center mb-4">
                    <svg class="brand-apple-logo mb-2" viewBox="0 0 170 170" width="36" height="36">
                        <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.04-7.67-7.81-11.94-14.3-6.19-9.36-11.05-20.08-14.57-32.17-3.52-12.09-5.28-23.72-5.28-34.91 0-16.22 4.18-29.62 12.53-40.21 8.36-10.59 18.79-15.99 31.31-16.2 5.09 0 10.59 1.34 16.51 4.02 5.92 2.68 9.77 4.08 11.55 4.2 1.56-.23 5.46-1.61 11.7-4.14 6.24-2.54 11.55-3.7 15.93-3.48 11.72.63 21.36 4.87 28.91 12.72-10.26 6.21-15.28 15.02-15.06 26.43.23 8.92 3.69 16.38 10.38 22.39 6.69 6 14.62 9.53 23.79 10.59-2.12 6.53-4.68 13.06-7.69 19.59zM119.22 32.64c0-7.25 2.67-14.17 8.01-20.76 5.34-6.59 11.83-10.96 19.46-13.12 1.01 7.25-.9 14.28-5.73 21.09-4.83 6.81-11.23 11.19-19.2 13.14-.67-.12-1.51-.24-2.54-.35z"/>
                    </svg>
                    <h2 class="fs-4 fw-bold text-dark mb-1">Đăng Nhập Khách Hàng</h2>
                    <p class="text-secondary small">@(IsCheckout ? "Đăng nhập để tiếp tục hoàn tất đơn hàng iPhone của bạn" : "Nhập Tên đăng nhập, Email hoặc Số điện thoại để bắt đầu")</p>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        <span>@_error</span>
                    </div>
                }

                <EditForm Model="Input" FormName="login" OnValidSubmit="DoLogin" method="post">
                    <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
                    <input type="hidden" name="Input.RequireCaptcha" value="@(_requireCaptcha ? "true" : "false")" />

                    <!-- Ô nhập 1 chạm nhận diện thông minh -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Tên đăng nhập / Email / Số điện thoại <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary">
                                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            </span>
                            <InputText @bind-Value="Input.Identifier" class="form-control rounded-end-3 py-2 px-3 border-start-0" placeholder="Ví dụ: nguyenvana, email@gmail.com, 0901234567" required autofocus />
                        </div>
                        <div class="form-text text-muted" style="font-size:0.75rem;">
                            Hệ thống tự động nhận diện theo định dạng bạn nhập.
                        </div>
                    </div>

                    <!-- Ô nhập mật khẩu có nút Toggle Ẩn/Hiện -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label class="form-label small fw-bold text-dark">Mật khẩu <span class="text-danger">*</span></label>
                            <a href="javascript:void(0);" onclick="alert('Tính năng khôi phục mật khẩu qua mã OTP SMS/Email đang được kết nối tổng đài. Vui lòng liên hệ Hotline 1900.6789 nếu cần hỗ trợ khẩn cấp!');" class="text-primary small text-decoration-none">Quên mật khẩu?</a>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-secondary">
                                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                            </span>
                            <input type="password" id="loginPassword" name="Input.Password" value="@Input.Password" class="form-control py-2 px-3 border-start-0 border-end-0" placeholder="Nhập mật khẩu của bạn" required />
                            <button type="button" class="btn btn-outline-secondary border-start-0 rounded-end-3 px-3 text-secondary" id="togglePasswordBtn" title="Hiển thị/Ẩn mật khẩu">
                                <svg id="eyeIcon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            </button>
                        </div>
                    </div>

                    <!-- Phòng vệ Brute-force Cấp 1: Thử thách CAPTCHA -->
                    @if (_requireCaptcha)
                    {
                        <div class="p-3 mb-3 bg-warning bg-opacity-10 border border-warning rounded-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-warning text-dark fw-bold">MÃ BẢO VỆ CAPTCHA</span>
                                <small class="text-secondary">Xác minh người dùng</small>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="fs-5 fw-bold px-3 py-1 bg-white border rounded text-primary tracking-wider" style="letter-spacing: 2px;">
                                    @_captchaQuestion
                                </span>
                                <span class="small text-muted">= ?</span>
                            </div>
                            <InputText @bind-Value="Input.CaptchaCode" class="form-control form-control-sm rounded-3 py-2 px-3" placeholder="Nhập kết quả phép tính" required />
                        </div>
                    }

                    <div class="form-check mb-4">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="form-check-input" id="rememberMe" />
                        <label class="form-check-label small text-secondary" for="rememberMe">
                            Ghi nhớ trạng thái đăng nhập trên thiết bị này (30 ngày)
                        </label>
                    </div>

                    <button type="submit" class="apple-cta-primary w-100 py-3 fs-6">
                        @(IsCheckout ? "Đăng nhập và tiếp tục thanh toán" : "Đăng Nhập Khách Hàng")
                    </button>
                </EditForm>

                <div class="text-center mt-4 pt-3 border-top">
                    <span class="text-secondary small">Chưa có tài khoản thành viên?</span>
                    <a href="/Account/Register@(string.IsNullOrEmpty(ReturnUrl) ? "" : $"?returnUrl={Uri.EscapeDataString(ReturnUrl)}")" class="text-primary fw-bold small ms-1 text-decoration-none">
                        Đăng ký nhanh trong 30s &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var toggleBtn = document.getElementById('togglePasswordBtn');
        var pwdInput = document.getElementById('loginPassword');
        if (toggleBtn && pwdInput) {
            toggleBtn.addEventListener('click', function () {
                var type = pwdInput.getAttribute('type') === 'password' ? 'text' : 'password';
                pwdInput.setAttribute('type', type);
                toggleBtn.classList.toggle('text-primary');
            });
        }
    });
</script>

@code {
    [CascadingParameter] private HttpContext? CascadingHttpContext { get; set; }
    [SupplyParameterFromForm] private LoginInput Input { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private bool IsCheckout => !string.IsNullOrEmpty(ReturnUrl) && (ReturnUrl.Contains("Checkout", StringComparison.OrdinalIgnoreCase) || ReturnUrl.Contains("Cart", StringComparison.OrdinalIgnoreCase));

    private string? _error;
    private bool _requireCaptcha = false;
    private string _captchaQuestion = "7 + 5 = ?";

    private HttpContext? CurrentContext => CascadingHttpContext ?? HttpContextAccessor.HttpContext;

    protected override void OnInitialized()
    {
        Input ??= new();
        var ctx = CurrentContext;
        if (ctx != null)
        {
            var sessionFails = ctx.Session.GetInt32("FailedLoginCount") ?? 0;
            if (sessionFails >= 3)
            {
                _requireCaptcha = true;
                EnsureCaptcha(ctx);
            }
        }
    }

    private void EnsureCaptcha(HttpContext ctx, bool forceNew = false)
    {
        var existing = ctx.Session.GetString("CaptchaQuestion");
        if (forceNew || string.IsNullOrEmpty(existing))
        {
            var (question, answer) = AuthHelper.GenerateMathCaptcha();
            ctx.Session.SetString("CaptchaQuestion", question);
            ctx.Session.SetString("CaptchaAnswer", answer);
            _captchaQuestion = question;
        }
        else
        {
            _captchaQuestion = existing;
        }
    }

    private async Task DoLogin()
    {
        var ctx = CurrentContext;
        var identifier = (Input.Identifier ?? "").Trim();
        if (string.IsNullOrEmpty(identifier) && !string.IsNullOrEmpty(Input.Username))
        {
            identifier = Input.Username.Trim();
        }

        var password = (Input.Password ?? "").Trim();

        var sessionFails = ctx?.Session.GetInt32("FailedLoginCount") ?? 0;
        bool isCaptchaRequired = _requireCaptcha || Input.RequireCaptcha || sessionFails >= 3;

        if (string.IsNullOrWhiteSpace(identifier) || string.IsNullOrWhiteSpace(password))
        {
            _error = "Vui lòng nhập đầy đủ thông tin định danh và mật khẩu!";
            _requireCaptcha = isCaptchaRequired;
            if (ctx != null && _requireCaptcha) EnsureCaptcha(ctx);
            return;
        }

        // 1. Phân loại đầu vào tất định (Deterministic Input Classifier - Mục 2.4.2.1)
        var user = await AuthHelper.FindUserByIdentifierAsync(UserManager, identifier);

        if (user != null && user.AccessFailedCount >= 3)
        {
            isCaptchaRequired = true;
        }

        // 2. Kiểm tra xác thực CAPTCHA nếu đang trong diện phòng vệ Cấp 1
        if (isCaptchaRequired && ctx != null)
        {
            var expectedAnswer = ctx.Session.GetString("CaptchaAnswer");
            if (string.IsNullOrWhiteSpace(Input.CaptchaCode) || Input.CaptchaCode.Trim() != expectedAnswer)
            {
                EnsureCaptcha(ctx, forceNew: true);
                _error = "Mã xác thực bảo vệ (CAPTCHA) không chính xác! Vui lòng thử lại.";
                _requireCaptcha = true;
                return;
            }
        }

        // 3. Phòng thủ chống rà quét danh tính (Username Enumeration Defense - Mục 2.4.2.4)
        if (user == null)
        {
            sessionFails++;
            ctx?.Session.SetInt32("FailedLoginCount", sessionFails);
            _error = "Tên đăng nhập hoặc mật khẩu không chính xác!";
            _requireCaptcha = sessionFails >= 3;
            if (ctx != null && _requireCaptcha) EnsureCaptcha(ctx);
            return;
        }

        // 4. Kiểm tra trạng thái khóa tài khoản (Brute-force Cấp 2 và Cấp 3)
        if (user.LockoutEnd.HasValue && user.LockoutEnd.Value > DateTimeOffset.UtcNow)
        {
            if (user.LockoutEnd.Value > DateTimeOffset.UtcNow.AddYears(1))
            {
                _error = "Tài khoản của bạn đã bị khóa vĩnh viễn do nhập sai mật khẩu quá 10 lần. Vui lòng liên hệ bộ phận hỗ trợ hoặc sử dụng 'Quên mật khẩu' để khôi phục!";
            }
            else
            {
                var remainingMinutes = Math.Ceiling((user.LockoutEnd.Value - DateTimeOffset.UtcNow).TotalMinutes);
                _error = $"Tài khoản tạm thời bị khóa do nhập sai mật khẩu nhiều lần. Vui lòng thử lại sau {remainingMinutes} phút hoặc dùng Quên mật khẩu.";
            }

            _requireCaptcha = true;
            if (ctx != null) EnsureCaptcha(ctx);
            return;
        }

        if (!user.IsActive)
        {
            _error = "Tài khoản của bạn đã bị ngừng kích hoạt. Vui lòng liên hệ quản trị viên cửa hàng!";
            _requireCaptcha = isCaptchaRequired;
            if (ctx != null && _requireCaptcha) EnsureCaptcha(ctx);
            return;
        }

        // 5. Kiểm tra phân hệ: Chỉ tài khoản vai trò Customer mới được phép đăng nhập Cổng Khách Hàng.
        var roles = await UserManager.GetRolesAsync(user);
        bool isCustomer = roles.Contains("Customer");
        bool isInternalOnly = roles.Any(r => r is "Admin" or "Manager" or "Staff" or "Cashier" or "Shipper") && !isCustomer;

        if (isInternalOnly)
        {
            sessionFails++;
            ctx?.Session.SetInt32("FailedLoginCount", sessionFails);
            _error = "Tên đăng nhập hoặc mật khẩu không chính xác!";
            _requireCaptcha = sessionFails >= 3;
            if (ctx != null && _requireCaptcha) EnsureCaptcha(ctx);
            return;
        }

        // 6. Xác thực mật khẩu
        var isPasswordValid = await UserManager.CheckPasswordAsync(user, password);
        if (!isPasswordValid)
        {
            await UserManager.AccessFailedAsync(user);
            var failCount = await UserManager.GetAccessFailedCountAsync(user);

            sessionFails++;
            ctx?.Session.SetInt32("FailedLoginCount", sessionFails);

            if (failCount >= 10)
            {
                // Cấp 3: Khóa cứng vĩnh viễn
                await UserManager.SetLockoutEndDateAsync(user, DateTimeOffset.MaxValue);
                _error = "Tài khoản của bạn đã bị khóa vĩnh viễn do nhập sai mật khẩu 10 lần liên tiếp. Vui lòng sử dụng 'Quên mật khẩu' để xác thực lại!";
                _requireCaptcha = true;
                if (ctx != null) EnsureCaptcha(ctx);
                return;
            }
            else if (failCount >= 5)
            {
                // Cấp 2: Khóa tạm thời 15 phút
                await UserManager.SetLockoutEndDateAsync(user, DateTimeOffset.UtcNow.AddMinutes(15));
                _error = "Tài khoản tạm thời bị khóa 15 phút do nhập sai mật khẩu 5 lần. Vui lòng thử lại sau hoặc dùng Quên mật khẩu.";
                _requireCaptcha = true;
                if (ctx != null) EnsureCaptcha(ctx);
                return;
            }
            else if (failCount >= 3 || sessionFails >= 3)
            {
                // Cấp 1: Yêu cầu giải CAPTCHA
                _error = "Tên đăng nhập hoặc mật khẩu không chính xác! Vui lòng nhập mã bảo vệ CAPTCHA bên dưới.";
                _requireCaptcha = true;
                if (ctx != null) EnsureCaptcha(ctx, forceNew: true);
                return;
            }
            else
            {
                _error = "Tên đăng nhập hoặc mật khẩu không chính xác!";
                _requireCaptcha = false;
                return;
            }
        }

        // 7. Xác thực thành công: Reset bộ đếm lỗi & Đăng nhập
        await UserManager.ResetAccessFailedCountAsync(user);
        if (ctx != null)
        {
            ctx.Session.Remove("FailedLoginCount");
            ctx.Session.Remove("CaptchaAnswer");
            ctx.Session.Remove("CaptchaQuestion");
        }

        var result = await SignInManager.PasswordSignInAsync(user, password, isPersistent: Input.RememberMe, lockoutOnFailure: false);
        if (!result.Succeeded)
        {
            _error = "Đăng nhập không thành công. Vui lòng thử lại!";
            return;
        }

        if (!string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//"))
            Nav.NavigateTo(ReturnUrl, forceLoad: true);
        else
            Nav.NavigateTo("/", forceLoad: true);
    }

    private sealed class LoginInput
    {
        public string Identifier { get; set; } = "";
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; } = true;
        public bool RequireCaptcha { get; set; } = false;
        public string? CaptchaCode { get; set; }
    }
}
