    </a>
    <a href="@Url(cat: 4, page: 1)" class="category-card text-decoration-none @(CategoryId == 4 ? "active" : "")">
        <img src="https://store.storeimages.cdn-apple.com/4982/as-images.apple.com/is/MTJV3?wid=1144&hei=1144&fmt=jpeg" alt="iPhone 13 & Cũ" class="category-img" />
        <div class="category-name">iPhone 13 & Cũ</div>
        <div class="category-count">Giá tốt, pin trâu, mượt mà</div>
    </a>
</section>

<!-- ================= 4. MAIN CATALOG ================= -->
<div class="container py-2" id="danh-sach-iphone">
    <!-- Series Filter Pills Bar & Dropdowns (Ảnh 4: Bộ Lọc xổ ra kế bên Sắp xếp) -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 pb-3 border-bottom">
        <!-- Left: Category Pills (Giữ nguyên tại chỗ không nhảy về đầu trang) -->
        <div class="d-flex align-items-center flex-wrap gap-2">
            <a href="@Url(cat: 0, page: 1)"
               class="btn btn-sm rounded-pill px-3 py-2 fw-semibold @(!CategoryId.HasValue || CategoryId == 0 ? "btn-primary" : "btn-light text-dark")">
                Tất cả iPhone
            </a>
            @foreach (var cat in _categories)
            {
                <a href="@Url(cat: cat.Id, page: 1)"
                   class="btn btn-sm rounded-pill px-3 py-2 fw-semibold @(CategoryId == cat.Id ? "btn-primary" : "btn-light text-dark")">
                    @cat.Name
                </a>
            }
        </div>

        <!-- Right: Filter Dropdown (Xổ ra) + Sort Dropdown -->
        <div class="d-flex align-items-center gap-2">
            <!-- Dropdown Bộ Lọc -->
            <div class="dropdown">
                <button class="btn btn-sm rounded-pill px-3 py-2 fw-semibold dropdown-toggle d-flex align-items-center gap-1 @(!string.IsNullOrEmpty(_storage) ? "btn-primary text-white" : "btn-outline-secondary")"
                        type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                    Bộ Lọc @(!string.IsNullOrEmpty(_storage) ? $"({_storage})" : "")
                </button>
                <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-3 rounded-4" style="min-width: 260px;">
                    <h6 class="dropdown-header px-0 text-dark fw-bold mb-2">Dung lượng bộ nhớ</h6>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <a href="@Url(storage: "", page: 1)"
                           class="btn btn-sm rounded-pill @(string.IsNullOrEmpty(_storage) ? "btn-dark" : "btn-light border")" style="font-size: 0.8rem;">
                            Tất cả
                        </a>
                        @foreach (var s in new[] { "128GB", "256GB", "512GB", "1TB" })
                        {
                            <a href="@Url(storage: s, page: 1)"
                               class="btn btn-sm rounded-pill @(_storage == s ? "btn-primary" : "btn-light border")" style="font-size: 0.8rem;">
                                @s
                            </a>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(_storage) || (CategoryId.HasValue && CategoryId.Value > 0) || !string.IsNullOrEmpty(_keyword))
                    {
                        <div class="border-top pt-2">
                            <a href="/#danh-sach-iphone" class="btn btn-outline-danger btn-sm w-100 rounded-pill" style="font-size:0.75rem;">
                                Xóa tất cả bộ lọc
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Sort By Dropdown -->
            <div class="d-flex align-items-center gap-2">
                <span class="text-secondary small d-none d-sm-inline">Sắp xếp:</span>
                <select @bind="_sort" class="form-select form-select-sm rounded-pill px-3" style="width: auto;" @bind:after="ApplyFilter">
                    <option value="">Mới nhất</option>
                    <option value="price_asc">Giá thấp đến cao</option>
                    <option value="price_desc">Giá cao đến thấp</option>
                    <option value="name">Tên máy A-Z</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Section Title & Counter -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fs-4 fw-bold text-dark mb-0">Các Dòng iPhone Chính Hãng</h2>
            <div class="text-secondary small">Hiện có @_totalCount sản phẩm đáp ứng tiêu chí</div>
        </div>
        <span class="badge bg-light text-dark border px-3 py-2">Trang @_page / @_totalPages</span>
    </div>

    <!-- ================= 2. PRODUCT CATALOG GRID (MOCKUP 01 & 02) ================= -->
    @if (_loading)
    {
        <div class="text-center py-5 text-secondary">
            <span class="spinner-border spinner-border-sm me-2"></span> Đang tải sản phẩm...
        </div>
    }
    else if (_products.Count == 0)
    {
        <div class="bg-white border rounded-3 p-5 text-center shadow-sm">
            <h5 class="fw-bold text-dark">Không tìm thấy sản phẩm iPhone nào</h5>
            <p class="text-secondary small">Vui lòng thử tìm kiếm với từ khóa hoặc dòng máy khác.</p>
            <a href="/" class="apple-cta-primary">Xem tất cả iPhone</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4 mb-4">
            @foreach (var item in _products)
            {
                <div class="col" @key="item.Id">
                    <div class="apple-card h-100 d-flex flex-column">
                        <!-- Product Image with fixed container & fallback -->
                        <a href="/product/@item.Id" class="product-img-wrap text-decoration-none">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://store.storeimages.cdn-apple.com/4982/as-images.apple.com/is/iphone-16-pro-finish-select-202409-6-9inch-deserttitanium?wid=940&hei=1112&fmt=png-alpha" : item.ImageUrl)"
                                 alt="@item.Name"
                                 class="product-card-img"
                                 onerror="this.onerror=null;this.src='/images/hero-iphone16.jpg';" />
                        </a>

                        <!-- Top Series Tag & Trả góp -->
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="product-series-tag mb-0">@(item.ModelSeries ?? item.Category?.Name ?? "Apple VN/A")</span>
                            <span class="badge bg-light text-success border fw-semibold" style="font-size: 0.72rem;">Trả góp 0%</span>
                        </div>

                        <!-- Product Title -->
                        <h3 class="product-title flex-grow-1">
                            <a href="/product/@item.Id" class="text-dark text-decoration-none">
                                @item.Name
                            </a>
                        </h3>

                        <!-- Color Dots Preview -->
                        <div class="color-dots-row">
                            <span class="color-dot" style="background-color: #c9b19e;" title="Titan Sa Mạc"></span>
                            <span class="color-dot" style="background-color: #9f9b96;" title="Titan Tự Nhiên"></span>
                            <span class="color-dot" style="background-color: #f2f1ed;" title="Titan Trắng"></span>
                            <span class="color-dot" style="background-color: #3c3b3e;" title="Titan Đen"></span>
                        </div>

                        <!-- Storage Mini Pills (Không bị dính liền) -->
                        <div class="storage-pills-row">
                            <span class="storage-mini-pill">@(string.IsNullOrEmpty(item.Storage) ? "128GB" : item.Storage)</span>
                            <span class="storage-mini-pill">VN/A</span>
                            <span class="storage-mini-pill">12 Tháng</span>
                        </div>

                        <!-- Price Row -->
                        <div class="product-price-row mt-auto">
                            <span class="price-current">@(item.Price > 0 ? item.Price.ToString("N0") + " ₫" : "Liên hệ")</span>
                            @if (item.Price > 0)
                            {
                                <span class="price-old">@((item.Price * 1.08m).ToString("N0")) ₫</span>
                                <span class="badge-discount">-6%</span>
                            }
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 mt-3">
                            <a href="/product/@item.Id" class="btn btn-outline-secondary btn-sm rounded-pill flex-fill py-2 text-center text-decoration-none">
                                Chi tiết
                            </a>
                            <button type="button" class="apple-cta-primary btn-sm flex-fill py-2 fs-6 text-center" @onclick="() => AddToCart(item)">
                                Mua Ngay
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- ================= 3. PAGINATION (MOCKUP 01 & 02) ================= -->
        @if (_totalPages > 1)
        {
            <nav class="apple-pagination mt-5 mb-4">
                @if (_page > 1)
                {
                    <a href="@Url(page: _page - 1)" class="page-link">‹ Trước</a>
                }
                else
                {
                    <span class="page-item disabled">‹ Trước</span>
                }

                @for (int i = 1; i <= _totalPages; i++)
                {
                    var pageNum = i;
                    if (_page == pageNum)
                    {
                        <span class="page-item active">@pageNum</span>
                    }
                    else
                    {
                        <a href="@Url(page: pageNum)" class="page-link">@pageNum</a>
                    }
                }

                @if (_page < _totalPages)
                {
                    <a href="@Url(page: _page + 1)" class="page-link">Sau ›</a>
                }
                else
                {
                    <span class="page-item disabled">Sau ›</span>
                }
            </nav>
        }
    }
</div>

