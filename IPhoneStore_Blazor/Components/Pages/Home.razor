@code {
    private const int PageSize = 8;

    [SupplyParameterFromQuery] public int? CategoryId { get; set; }
    [SupplyParameterFromQuery] public string? SearchKeyword { get; set; }
    [SupplyParameterFromQuery] public string? StorageFilter { get; set; }
    [SupplyParameterFromQuery] public string? SortBy { get; set; }
    [SupplyParameterFromQuery] public int? CurrentPage { get; set; }

    private List<Category> _categories = new();
    private List<Product> _products = new();
    private int _page = 1, _totalPages = 1, _totalCount;
    private bool _loading = true;
    private string? _keyword, _storage, _sort;

    protected override async Task OnParametersSetAsync()
    {
        _keyword = SearchKeyword;
        _storage = StorageFilter ?? "";
        _sort = SortBy ?? "";
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Cart.EnsureLoadedAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        _categories = await db.Categories.Where(c => c.IsActive).OrderBy(c => c.DisplayOrder).ToListAsync();

        var query = db.Products.Include(p => p.Category).Where(p => p.IsActive);

        if (CategoryId.HasValue && CategoryId.Value > 0)
        {
            query = query.Where(p => p.CategoryId == CategoryId.Value);
        }

        if (!string.IsNullOrWhiteSpace(_keyword))
        {
            var kw = _keyword.Trim().ToLower();
            query = query.Where(p => p.Name.ToLower().Contains(kw) ||
                                     p.ModelSeries.ToLower().Contains(kw) ||
                                     p.Color.ToLower().Contains(kw));
        }

        if (!string.IsNullOrWhiteSpace(_storage))
        {
            query = query.Where(p => p.Storage == _storage);
        }

        query = _sort switch
        {
            "price_asc" => query.OrderBy(p => p.Price),
            "price_desc" => query.OrderByDescending(p => p.Price),
            "name" => query.OrderBy(p => p.Name),
            _ => query.OrderByDescending(p => p.Id)
        };

        _totalCount = await query.CountAsync();
        _totalPages = (int)Math.Ceiling(_totalCount / (double)PageSize);
        if (_totalPages < 1) _totalPages = 1;

        _page = CurrentPage ?? 1;
        if (_page < 1) _page = 1;
        if (_page > _totalPages) _page = _totalPages;

        _products = await query.Skip((_page - 1) * PageSize).Take(PageSize).ToListAsync();
        _loading = false;
    }

    private void ApplyFilter()
    {
        Nav.NavigateTo(Url(cat: CategoryId, page: 1, kw: _keyword, storage: _storage, sort: _sort));
    }

    private string Url(int? cat = null, int? page = null, string? kw = null, string? storage = null, string? sort = null)
    {
        var targetCat = cat ?? CategoryId;
        var targetPage = page ?? _page;
        var targetKw = kw ?? _keyword;
        var targetStorage = storage ?? _storage;
        var targetSort = sort ?? _sort;

        var q = new List<string>();
        if (targetCat.HasValue && targetCat.Value > 0) q.Add($"categoryId={targetCat.Value}");
        if (!string.IsNullOrWhiteSpace(targetKw)) q.Add($"searchKeyword={Uri.EscapeDataString(targetKw)}");
        if (!string.IsNullOrWhiteSpace(targetStorage)) q.Add($"storageFilter={Uri.EscapeDataString(targetStorage)}");
        if (!string.IsNullOrWhiteSpace(targetSort)) q.Add($"sortBy={Uri.EscapeDataString(targetSort)}");
        if (targetPage > 1) q.Add($"currentPage={targetPage}");

        return (q.Count == 0 ? "/" : "/?" + string.Join("&", q)) + "#danh-sach-iphone";
    }

    private async Task AddToCart(Product p)
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated != true)
        {
            // Chưa đăng nhập thì không có giỏ hàng -> Chuyển sang trang Đăng nhập
            Nav.NavigateTo($"/Account/Login?returnUrl={Uri.EscapeDataString($"/product/{p.Id}")}", forceLoad: true);
            return;
        }

        if ((user.IsInRole("Admin") || user.IsInRole("Manager") || user.IsInRole("Staff") || user.IsInRole("Cashier") || user.IsInRole("Shipper")) &&
            !user.IsInRole("Customer"))
        {
            Toast.Warning("Tài khoản quản trị viên / nội bộ không được phép mua hàng theo chuẩn AAR!");
            return;
        }

        var result = await Cart.AddToCartAsync(p, 1);
        if (result.Success)
        {
            Toast.Success(result.Message);
            Nav.NavigateTo("/cart");
        }
        else
        {
            Toast.Error(result.Message);
        }
    }
}

