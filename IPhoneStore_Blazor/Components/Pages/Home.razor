<!-- ================= 3. CATEGORY CARDS GRID ================= -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="fs-4 fw-bold text-dark mb-0">Danh Mục Sản Phẩm Apple</h2>
    <span class="text-secondary small">Chuẩn máy mới 100% VN/A</span>
</div>
<section class="category-cards-grid mb-4">
    <a href="@Url(cat: 1, page: 1)" class="category-card text-decoration-none @(CategoryId == 1 ? "active" : "")">
        <img src="https://store.storeimages.cdn-apple.com/4982/as-images.apple.com/is/iphone-16-pro-finish-select-202409-6-9inch-deserttitanium?wid=940&hei=1112&fmt=png-alpha" alt="iPhone 16 Series" class="category-img" />
        <div class="category-name">iPhone 16 Series</div>
        <div class="category-count">Titan Sa Mạc, Pro & Plus</div>
    </a>
    <a href="@Url(cat: 2, page: 1)" class="category-card text-decoration-none @(CategoryId == 2 ? "active" : "")">
        <img src="https://store.storeimages.cdn-apple.com/4982/as-images.apple.com/is/iphone-15-finish-select-202309-6-1inch-blue?wid=5120&hei=2880&fmt=p-jpg" alt="iPhone 15 Series" class="category-img" />
        <div class="category-name">iPhone 15 Series</div>
        <div class="category-count">Dynamic Island, USB-C</div>
    </a>
    <a href="@Url(cat: 3, page: 1)" class="category-card text-decoration-none @(CategoryId == 3 ? "active" : "")">
        <img src="https://store.storeimages.cdn-apple.com/4982/as-images.apple.com/is/iphone-14-finish-select-202209-6-1inch-blue?wid=5120&hei=2880&fmt=p-jpg" alt="iPhone 14 Series" class="category-img" />
        <div class="category-name">iPhone 14 Series</div>
