@page "/admin/inventory"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin,Manager,Staff,Cashier,Shipper")]
@inject IDbContextFactory<IPhoneStoreDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Kho IMEI &amp; Serial Number - BomChelsea Admin</PageTitle>

<div>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1">INVENTORY TRACKING</span>
                <span class="text-secondary small">Quản lý định danh từng thân máy theo chuẩn Apple</span>
            </div>
            <h1 class="fs-3 fw-bold text-dark mb-0">Kho IMEI &amp; Serial Number</h1>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/batch-import" class="apple-cta-primary py-2 px-3 fs-6 text-decoration-none">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                <span>Nhập Lô IMEI Mới &rarr;</span>
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_alert))
    {
        <div class="alert alert-@_alertType alert-dismissible fade show border-0 rounded-3 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>@_alert</span>
            </div>
            <button type="button" class="btn-close" @onclick="() => _alert = null"></button>
        </div>
    }

    <!-- 4 Stat Counters -->
    <div class="admin-stat-grid mb-4">
        <div class="admin-stat-card">
            <div class="admin-stat-label">Tổng IMEI Hệ Thống</div>
            <div class="admin-stat-value text-dark">@_totalCount</div>
        </div>
        <div class="admin-stat-card">
            <div class="admin-stat-label">Sẵn Sàng Xuất Kho (InStock)</div>
            <div class="admin-stat-value text-success">@_inStockCount</div>
        </div>
        <div class="admin-stat-card">
            <div class="admin-stat-label">Đang Giữ Chỗ Đơn (Reserved)</div>
            <div class="admin-stat-value text-warning">@_reservedCount</div>
        </div>
        <div class="admin-stat-card">
            <div class="admin-stat-label">Đã Xuất Bán (Sold)</div>
            <div class="admin-stat-value text-secondary">@_soldCount</div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="bg-white border rounded-3 p-3 mb-4 shadow-sm">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <input type="text" @bind="_keyword" @bind:event="oninput" class="form-control rounded-3 py-2 px-3" placeholder="Tìm theo 15 số IMEI, Serial Number..." />
            </div>
            <div class="col-md-3">
                <select @bind="_filterProduct" class="form-select rounded-3 py-2">
                    <option value="0">Tất cả sản phẩm / SKU</option>
                    @foreach (var p in _products)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select @bind="_filterStatus" class="form-select rounded-3 py-2">
                    <option value="">Tất cả trạng thái</option>
                    <option value="InStock">Trong kho (InStock)</option>
                    <option value="Reserved">Đang giữ chỗ (Reserved)</option>
                    <option value="Sold">Đã bán (Sold)</option>
                    <option value="Defective">Lỗi / Đổi trả (Defective)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="button" class="apple-cta-primary btn-sm flex-fill py-2" @onclick="ApplyFilter">Lọc</button>
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2" @onclick="ResetFilter">Reset</button>
            </div>
        </div>
    </div>

    <!-- Inventory IMEI Table -->
    <div class="admin-table-container">
        <div class="admin-table-header">
            <div>
                <h3 class="fs-6 fw-bold text-dark mb-0">Danh Sách IMEI (@_totalCount mã)</h3>
                <div class="text-secondary small">Cập nhật và tra cứu trạng thái máy đơn lẻ</div>
            </div>
            <span class="badge bg-light text-dark border">Trang @_page / @_totalPages</span>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã IMEI (15 số)</th>
                        <th>Số Serial</th>
                        <th>Sản phẩm / Biến thể</th>
                        <th>Trạng thái kho</th>
                        <th>Ngày nhập kho</th>
                        <th>Đơn hàng gán</th>
                        <th class="text-end" style="width: 140px;">Cập nhật</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_imeis.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-5">
                                Không tìm thấy mã IMEI nào phù hợp với bộ lọc tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var imei in _imeis)
                        {
                            <tr @key="imei.Id">
                                <td>
                                    <span class="font-monospace fw-bold text-dark fs-6">@imei.Imei</span>
                                </td>
                                <td>
                                    <span class="font-monospace text-secondary small">@(string.IsNullOrEmpty(imei.SerialNumber) ? "N/A" : imei.SerialNumber)</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark small">@(imei.Product?.Name ?? $"SKU #{imei.ProductId}")</div>
                                    <div class="text-secondary" style="font-size: 0.72rem;">@(imei.Product?.ModelSeries) - @(imei.Product?.Color) (@(imei.Product?.Storage))</div>
                                </td>
                                <td>
                                    @if (imei.Status == "InStock")
                                    {
                                        <span class="status-pill success">Trong kho (InStock)</span>
                                    }
                                    else if (imei.Status == "Reserved")
                                    {
                                        <span class="status-pill warning">Đang giữ chỗ (Reserved)</span>
                                    }
                                    else if (imei.Status == "Sold")
                                    {
                                        <span class="status-pill info">Đã bán (Sold)</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill danger">@imei.Status</span>
                                    }
                                </td>
                                <td class="text-secondary small">
                                    @imei.ImportDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @if (imei.OrderId.HasValue)
                                    {
                                        <span class="badge bg-light text-primary border">#IPS@imei.OrderId.Value.ToString("D6")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa xuất</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" @onclick="() => OpenStatusModal(imei)">
                                        Đổi trạng thái
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (_totalPages > 1)
        {
            <div class="p-3 border-top">
                <nav class="apple-pagination mb-0">
                    @if (_page > 1)
                    {
                        <a href="javascript:void(0);" class="page-link" @onclick="() => ChangePage(_page - 1)">‹ Trước</a>
                    }
                    else
                    {
                        <span class="page-item disabled">‹ Trước</span>
                    }

                    @for (int i = 1; i <= _totalPages; i++)
                    {
                        var pageNum = i;
                        if (_page == pageNum)
                        {
                            <span class="page-item active">@pageNum</span>
                        }
                        else
                        {
                            <a href="javascript:void(0);" class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</a>
                        }
                    }

                    @if (_page < _totalPages)
                    {
                        <a href="javascript:void(0);" class="page-link" @onclick="() => ChangePage(_page + 1)">Sau ›</a>
                    }
                    else
                    {
                        <span class="page-item disabled">Sau ›</span>
                    }
                </nav>
            </div>
        }
    </div>
</div>

<!-- Modal cập nhật trạng thái IMEI -->
@if (_selectedImei != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold text-dark mb-0">Cập Nhật Trạng Thái IMEI</h5>
                    <button type="button" class="btn-close" @onclick="() => _selectedImei = null"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small text-secondary">Mã IMEI:</label>
                        <div class="font-monospace fw-bold fs-5 text-primary">@_selectedImei.Imei</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-secondary">Sản phẩm:</label>
                        <div class="fw-semibold text-dark">@_selectedImei.Product?.Name</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Chọn trạng thái mới: <span class="text-danger">*</span></label>
                        <select @bind="_newImeiStatus" class="form-select rounded-3 py-2">
                            <option value="InStock">Trong kho (InStock)</option>
                            <option value="Reserved">Đang giữ chỗ đơn (Reserved)</option>
                            <option value="Sold">Đã xuất bán cho khách (Sold)</option>
                            <option value="Defective">Máy lỗi phần cứng / Đổi mới (Defective)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Ghi chú điều chỉnh:</label>
                        <input type="text" @bind="_selectedImei.Notes" class="form-control rounded-3 py-2" placeholder="Lý do chuyển trạng thái..." />
                    </div>
                </div>
                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" @onclick="() => _selectedImei = null">Hủy</button>
                    <button type="button" class="apple-cta-primary px-4 py-2" @onclick="SaveStatusAsync">
                        Lưu Cập Nhật &rarr;
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const int PageSize = 10;
    private List<ProductImei> _imeis = new();
    private List<Product> _products = new();
    private ProductImei? _selectedImei;
    private string _newImeiStatus = "InStock";

    private string? _alert;
    private string _alertType = "success";

    private string _keyword = "";
    private int _filterProduct = 0;
    private string _filterStatus = "";

    private int _page = 1, _totalPages = 1, _totalCount;
    private int _inStockCount, _reservedCount, _soldCount;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _products = await db.Products.Where(p => p.IsActive).OrderBy(p => p.Name).ToListAsync();
        await LoadStatsAsync();
        await LoadImeisAsync();
    }

    private async Task LoadStatsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _inStockCount = await db.ProductImeis.CountAsync(i => i.Status == "InStock");
        _reservedCount = await db.ProductImeis.CountAsync(i => i.Status == "Reserved");
        _soldCount = await db.ProductImeis.CountAsync(i => i.Status == "Sold");
    }

    private async Task LoadImeisAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var query = db.ProductImeis.Include(i => i.Product).AsQueryable();

        if (!string.IsNullOrWhiteSpace(_keyword))
        {
            var kw = _keyword.Trim().ToLower();
            query = query.Where(i => i.Imei.Contains(kw) || (i.SerialNumber != null && i.SerialNumber.ToLower().Contains(kw)));
        }

        if (_filterProduct > 0)
        {
            query = query.Where(i => i.ProductId == _filterProduct);
        }

        if (!string.IsNullOrWhiteSpace(_filterStatus))
        {
            query = query.Where(i => i.Status == _filterStatus);
        }

        _totalCount = await query.CountAsync();
        _totalPages = (int)Math.Ceiling(_totalCount / (double)PageSize);
        if (_totalPages < 1) _totalPages = 1;
        if (_page < 1) _page = 1;
        if (_page > _totalPages) _page = _totalPages;

        _imeis = await query
            .OrderByDescending(i => i.ImportDate)
            .Skip((_page - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();
    }

    private async Task ApplyFilter()
    {
        _page = 1;
        await LoadImeisAsync();
    }

    private async Task ResetFilter()
    {
        _keyword = "";
        _filterProduct = 0;
        _filterStatus = "";
        _page = 1;
        await LoadImeisAsync();
    }

    private async Task ChangePage(int newPage)
    {
        _page = newPage;
        await LoadImeisAsync();
    }

    private void OpenStatusModal(ProductImei imei)
    {
        _selectedImei = imei;
        _newImeiStatus = imei.Status;
    }

    private async Task SaveStatusAsync()
    {
        if (_selectedImei == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.ProductImeis.FindAsync(_selectedImei.Id);
        if (entity != null)
        {
            var oldStatus = entity.Status;
            entity.Status = _newImeiStatus;
            entity.Notes = _selectedImei.Notes;

            // Đồng bộ tồn kho Product: Nếu chuyển từ InStock sang trạng thái khác thì giảm, hoặc ngược lại
            var prod = await db.Products.FindAsync(entity.ProductId);
            if (prod != null)
            {
                if (oldStatus != "InStock" && _newImeiStatus == "InStock")
                {
                    prod.Quantity += 1;
                }
                else if (oldStatus == "InStock" && _newImeiStatus != "InStock")
                {
                    prod.Quantity = Math.Max(0, prod.Quantity - 1);
                }
            }

            await db.SaveChangesAsync();
            _alert = $"Đã cập nhật trạng thái IMEI {entity.Imei} thành '{_newImeiStatus}'!";
            _alertType = "success";
        }
        _selectedImei = null;
        await LoadStatsAsync();
        await LoadImeisAsync();
    }
}
