@page "/admin/login"
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Identity
@using IPhoneStore_Blazor.Models.Entities
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Nav

<PageTitle>Cổng Đăng Nhập Quản Trị Viên (Admin Portal) - iStore Titanium</PageTitle>

<style>
    body.admin-login-body {
        background: radial-gradient(circle at 50% 20%, #161b26 0%, #0a0c10 70%, #050608 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: #f5f5f7;
        padding: 20px;
        margin: 0;
    }
    .admin-login-card {
        background: rgba(18, 22, 34, 0.75);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 20px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 1px 1px rgba(255, 255, 255, 0.1) inset;
        width: 100%;
        max-width: 440px;
        padding: 40px;
        position: relative;
        overflow: hidden;
    }
    .admin-login-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #ff9f0a, #ffd60a, #30d158, #2997ff);
    }
    .admin-shield-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(255, 159, 10, 0.15), rgba(255, 214, 10, 0.05));
        border: 1px solid rgba(255, 159, 10, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        box-shadow: 0 8px 24px rgba(255, 159, 10, 0.15);
        color: #ff9f0a;
    }
    .admin-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 100px;
        background: rgba(255, 159, 10, 0.12);
        border: 1px solid rgba(255, 159, 10, 0.25);
        color: #ffb340;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 12px;
    }
    .btn-admin-submit {
        background: linear-gradient(180deg, #2c2f38 0%, #1a1d24 100%);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        font-weight: 600;
        padding: 13px 20px;
        width: 100%;
        transition: all 0.25s ease;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .btn-admin-submit:hover {
        background: linear-gradient(180deg, #3a3f4c 0%, #242933 100%);
        border-color: rgba(255, 159, 10, 0.6);
        color: #ffffff;
        box-shadow: 0 6px 20px rgba(255, 159, 10, 0.2);
        transform: translateY(-1px);
    }
</style>

<div class="d-flex align-items-center justify-content-center py-5" style="min-height: 80vh;">
    <div class="admin-login-card">
        <div class="text-center">
            <div class="admin-shield-icon">
                <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
            </div>
            <div>
                <span class="admin-badge-pill">
                    <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#30d158;"></span>
                    SECURITY CONTROL PORTAL
                </span>
            </div>
            <h4 class="fw-bold text-white mb-1">iStore Administrator</h4>
            <p class="text-secondary small mb-4">Cổng xác thực đặc quyền Quản trị viên hệ thống (Identity)</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger bg-danger bg-opacity-25 border border-danger border-opacity-50 text-white small mb-4 py-2 px-3 rounded-3">
                <div class="d-flex align-items-center gap-2">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <span>@_error</span>
                </div>
            </div>
        }

        <EditForm Model="Input" FormName="admin-login" OnValidSubmit="DoAdminLogin" method="post">
            <div class="mb-3">
                <label class="form-label text-secondary small fw-bold">Tài Khoản Quản Trị (Admin ID)</label>
                <InputText @bind-Value="Input.Username" class="form-control apple-input" placeholder="admin" autofocus />
            </div>

            <div class="mb-4">
                <label class="form-label text-secondary small fw-bold">Khóa Bảo Mật (Admin Password)</label>
                <InputText type="password" @bind-Value="Input.Password" class="form-control apple-input" placeholder="••••••••" />
            </div>

            <button type="submit" class="btn-admin-submit mb-3">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
                Xác Thực & Vào Quản Trị
            </button>

            <!-- Gợi ý tài khoản demo -->
            <div class="p-3 rounded-3 mb-4 text-start border border-secondary border-opacity-10 small" style="background: rgba(255,255,255,0.02);">
                <div class="text-white fw-semibold mb-1">Tài khoản Quản trị viên Identity:</div>
                <div class="text-secondary">&bull; Username: <code class="text-warning">admin</code></div>
                <div class="text-secondary">&bull; Password: <code class="text-warning">admin123</code></div>
            </div>

            <div class="text-center pt-2 border-top border-secondary border-opacity-10">
                <a href="/" class="text-secondary text-decoration-none small d-inline-flex align-items-center gap-1 hover-white">
                    <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    Quay về Cửa Hàng iPhone
                </a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm] private AdminLoginInput Input { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    protected override void OnInitialized() => Input ??= new();

    private string? _error;

    private async Task DoAdminLogin()
    {
        if (Input == null || string.IsNullOrWhiteSpace(Input.Username) || string.IsNullOrWhiteSpace(Input.Password))
        {
            _error = "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu Quản Trị!";
            return;
        }

        var username = Input.Username.Trim();
        var user = await UserManager.FindByNameAsync(username);

        if (user == null)
        {
            _error = "Tên đăng nhập hoặc mật khẩu Quản Trị không chính xác!";
            return;
        }

        if (!user.IsActive)
        {
            _error = "Tài khoản quản trị này đã bị vô hiệu hóa!";
            return;
        }

        // Kiểm tra quyền hạn: Tài khoản phải thuộc danh sách vai trò nội bộ quản trị vận hành
        var roles = await UserManager.GetRolesAsync(user);
        bool hasAdminAccess = roles.Any(r => r is "Admin" or "Manager" or "Staff" or "Cashier" or "Shipper");
        if (!hasAdminAccess)
        {
            _error = "Truy cập bị từ chối: Tài khoản của bạn không có quyền truy cập hệ thống Quản trị!";
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(user, Input.Password.Trim(), isPersistent: true, lockoutOnFailure: false);
        if (!result.Succeeded)
        {
            _error = "Tên đăng nhập hoặc mật khẩu Quản Trị không chính xác!";
            return;
        }

        if (!string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.Contains("/Account/Login"))
            Nav.NavigateTo(ReturnUrl, forceLoad: true);
        else
            Nav.NavigateTo("/admin/products", forceLoad: true);
    }

    private sealed class AdminLoginInput
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
