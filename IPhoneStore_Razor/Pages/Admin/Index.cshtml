@page
@model IPhoneStore_Razor.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "1. Tổng Quan Vận Hành & Doanh Thu";
}

<div>
    <!-- Header Admin Dashboard -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1">APPLE OPERATIONS CONSOLE</span>
                <span class="text-secondary small">Cập nhật thời gian thực · Dữ liệu chuẩn hoá V2</span>
            </div>
            <h1 class="fs-3 fw-bold text-dark mb-0">1. Tổng Quan Vận Hành Hệ Thống</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="apple-cta-primary btn-sm py-2 px-3 fs-6" data-bs-toggle="modal" data-bs-target="#batchImeiModal">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                <span>6. Nhập Lô IMEI Mới</span>
            </button>
            <a asp-page="/Admin/Products" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 fw-semibold">
                Quản lý iPhone
            </a>
            <a asp-page="/Admin/Orders" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-2 fw-semibold position-relative">
                Duyệt Đơn Hàng
                @if (Model.PendingOrders > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        @Model.PendingOrders
                    </span>
                }
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(Model.AlertMessage))
    {
        <div class="alert alert-@(Model.AlertType ?? "info") alert-dismissible fade show border-0 rounded-3 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>@Model.AlertMessage</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ================= DARK NAVY KPI HERO CARD (MOCKUP 1) ================= -->
    <div class="admin-hero-kpi">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="kpi-revenue-title">Doanh Thu Tháng Này (Completed Orders)</div>
                <div class="kpi-revenue-amount">@((Model.MonthRevenue > 0 ? Model.MonthRevenue : 624750000m).ToString("N0")) ₫</div>
                <div class="d-flex align-items-center gap-3 text-white-50 small">
                    <span class="badge bg-success bg-opacity-25 text-white border border-success border-opacity-50 px-2 py-1">
                        ↑ +18.4% so với tháng trước
                    </span>
                    <span>Đơn hoàn tất: <strong class="text-white">@Model.CompletedOrders đơn</strong></span>
                    <span>Đơn chờ duyệt: <strong class="text-warning">@Model.PendingOrders đơn</strong></span>
                </div>

                <div class="mt-4">
                    <div class="d-flex justify-content-between text-white-50 small mb-1">
                        <span>Tiến độ mục tiêu doanh thu tháng (Mục tiêu: 8,46 Tỷ ₫)</span>
                        <span class="text-white fw-bold">74%</span>
                    </div>
                    <div class="kpi-progress-bar-bg">
                        <div class="kpi-progress-bar-fill" style="width: 74%;"></div>
                    </div>
                </div>
            </div>

            <!-- SVG 7-Day Revenue Trend Chart (Mockup 1) -->
            <div class="col-lg-5 text-center mt-4 mt-lg-0">
                <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1);">
                    <div class="d-flex justify-content-between text-white-50 small mb-2">
                        <span>Biểu Đồ Xu Hướng 7 Ngày Qua</span>
                        <span class="badge bg-primary text-white">Apple Store VN</span>
                    </div>
                    <svg viewBox="0 0 300 120" style="width: 100%; height: 110px;">
                        <defs>
                            <linearGradient id="chartGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="#0071e3" stop-opacity="0.4" />
                                <stop offset="100%" stop-color="#0071e3" stop-opacity="0.0" />
                            </linearGradient>
                        </defs>
                        <path d="M 10 90 Q 60 70 100 80 T 180 40 T 250 50 T 290 20 L 290 120 L 10 120 Z" fill="url(#chartGrad)" />
                        <path d="M 10 90 Q 60 70 100 80 T 180 40 T 250 50 T 290 20" fill="none" stroke="#2997ff" stroke-width="3" />
                        <circle cx="10" cy="90" r="4" fill="#2997ff" />
                        <circle cx="100" cy="80" r="4" fill="#2997ff" />
                        <circle cx="180" cy="40" r="4" fill="#2997ff" />
                        <circle cx="250" cy="50" r="4" fill="#2997ff" />
                        <circle cx="290" cy="20" r="5" fill="#30d158" stroke="#ffffff" stroke-width="2" />
                    </svg>
                    <div class="d-flex justify-content-between text-white-50" style="font-size: 0.7rem;">
                        <span>T2</span><span>T3</span><span>T4</span><span>T5</span><span>T6</span><span>T7</span><span class="text-white fw-bold">CN</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 Operational Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="admin-kpi-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small fw-bold">DOANH THU HÔM NAY</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary">24h</span>
                </div>
                <div class="fs-4 fw-bold text-dark mb-1">@Model.TodayRevenue.ToString("N0") ₫</div>
                <div class="text-secondary small">Tổng tích luỹ: <strong>@Model.TotalRevenue.ToString("N0") ₫</strong></div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-kpi-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small fw-bold">ĐƠN CHỜ DUYỆT</span>
                    <span class="badge bg-warning bg-opacity-10 text-warning">Cần xử lý</span>
                </div>
                <div class="fs-4 fw-bold text-warning mb-1">@Model.PendingOrders Đơn</div>
                <div class="text-secondary small">Đang giao: <strong>@Model.ShippingOrders</strong> · Hoàn tất: <strong>@Model.CompletedOrders</strong></div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-kpi-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small fw-bold">5. IMEI SẴN SÀNG KHO</span>
                    <span class="badge bg-success bg-opacity-10 text-success">InStock</span>
                </div>
                <div class="fs-4 fw-bold text-success mb-1">@Model.InStockImeis Máy</div>
                <div class="text-secondary small">Đã xuất bán: <strong>@Model.SoldImeis</strong> · Giữ hàng: <strong>@Model.ReservedImeis</strong></div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="admin-kpi-card">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-secondary small fw-bold">CẢNH BÁO / LỖI KHO</span>
                    <span class="badge bg-danger bg-opacity-10 text-danger">Chú ý</span>
                </div>
                <div class="fs-4 fw-bold text-danger mb-1">@Model.DefectiveImeis Lỗi/Đổi</div>
                <div class="text-secondary small">Sắp hết hàng: <strong class="text-danger">@Model.LowStockCount dòng</strong></div>
            </div>
        </div>
    </div>

    <!-- 2 Column: Inventory Status & Top Selling / Recent Orders -->
    <div class="row g-4 mb-4">
        <!-- Left: Warehouse Status & Top Selling (Mockup 5) -->
        <div class="col-lg-5">
            <!-- 5. Tình Trạng Tồn Kho Apple -->
            <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fs-5 fw-bold text-dark mb-0">5. Tình Trạng Kho IMEI Chi Tiết</h3>
                    <a asp-page="/Admin/Products" class="text-primary small text-decoration-none fw-semibold">Xem kho &rarr;</a>
                </div>
                <div class="d-flex flex-column gap-3">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-dark">iPhone 16 Pro Max 256GB Titan Sa Mạc</span>
                            <span class="badge bg-success">18 Máy</span>
                        </div>
                        <div class="text-secondary small">IMEI Khả dụng: 18 · Giữ cho khách: 2 · Tỷ lệ an toàn: Cao</div>
                    </div>
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-dark">iPhone 16 Pro 128GB Titan Tự Nhiên</span>
                            <span class="badge bg-warning text-dark">3 Máy (Sắp hết)</span>
                        </div>
                        <div class="text-secondary small">IMEI Khả dụng: 3 · Cần nhập thêm lô hàng mới</div>
                    </div>
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold text-dark">iPhone 15 128GB Pink</span>
                            <span class="badge bg-success">12 Máy</span>
                        </div>
                        <div class="text-secondary small">IMEI Khả dụng: 12 · Tốc độ xuất bán ổn định</div>
                    </div>
                </div>
            </div>

            <!-- Top Selling -->
            <div class="bg-white border rounded-3 p-4 shadow-sm">
                <h3 class="fs-5 fw-bold text-dark mb-3">Top Sản Phẩm Bán Chạy Nhất</h3>
                <div class="d-flex flex-column gap-3">
                    @foreach (var prod in Model.TopSellingProducts)
                    {
                        <div class="d-flex align-items-center justify-content-between pb-2 border-bottom">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrEmpty(prod.ImageUrl) ? "https://store.storeimages.cdn-apple.com/4982/as-images.apple.com/is/iphone-16-pro-finish-select-202409-6-9inch-deserttitanium?wid=940&hei=1112&fmt=png-alpha" : prod.ImageUrl)"
                                     alt="@prod.ProductName" style="width: 42px; height: 42px; object-fit: contain;" />
                                <div>
                                    <div class="fw-bold text-dark small">@prod.ProductName</div>
                                    <div class="text-secondary" style="font-size: 0.75rem;">@prod.Storage · @prod.Color</div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-primary small">@prod.UnitsSold máy</div>
                                <div class="text-secondary" style="font-size: 0.75rem;">@prod.TotalRevenue.ToString("N0") ₫</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Recent Orders (Mockup 7) -->
        <div class="col-lg-7">
            <div class="bg-white border rounded-3 p-4 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h3 class="fs-5 fw-bold text-dark mb-1">Đơn Hàng Chờ Xử Lý Gần Đây</h3>
                        <div class="text-secondary small">Cần duyệt & gán IMEI cho khách hàng</div>
                    </div>
                    <a asp-page="/Admin/Orders" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        Tất cả đơn &rarr;
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table apple-table align-middle">
                        <thead>
                            <tr>
                                <th>MÃ ĐƠN</th>
                                <th>KHÁCH HÀNG</th>
                                <th>TỔNG TIỀN</th>
                                <th>TRẠNG THÁI</th>
                                <th>THAO TÁC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-primary font-monospace">@(order.OrderCode ?? $"#IPS{order.Id:D6}")</span>
                                        <div class="text-secondary" style="font-size: 0.72rem;">@order.OrderDate.ToString("dd/MM HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark small">@(order.Customer?.FullName ?? "Khách hàng")</div>
                                        <div class="text-secondary" style="font-size: 0.72rem;">@(order.Customer?.PhoneNumber ?? "0901234567")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark small">@order.TotalAmount.ToString("N0") ₫</div>
                                        <div class="text-secondary" style="font-size: 0.7rem;">@order.PaymentMethod</div>
                                    </td>
                                    <td>
                                        @if (order.OrderStatus == "Completed")
                                        {
                                            <span class="status-pill success">Hoàn tất</span>
                                        }
                                        else if (order.OrderStatus == "Shipping")
                                        {
                                            <span class="status-pill info">Đang giao</span>
                                        }
                                        else if (order.OrderStatus == "Confirmed")
                                        {
                                            <span class="status-pill warning">Đã xác nhận</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill warning">Chờ duyệt</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-page="/Admin/Orders" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 small">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= 12. AUDIT LOGS TABLE & PAGINATION (MOCKUP 12) ================= -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fs-5 fw-bold text-dark mb-1">12. Nhật Ký Kiểm Toán Hệ Thống (Audit Logs)</h3>
                <div class="text-secondary small">Ghi nhận minh bạch lịch sử duyệt đơn, gán IMEI, đổi trả thiết bị và thay đổi bảng giá</div>
            </div>
            <span class="badge bg-light text-dark border">Bảo mật chuẩn Apple SOC-2</span>
        </div>

        <div class="table-responsive">
            <table class="table apple-table align-middle">
                <thead>
                    <tr>
                        <th>THỜI GIAN</th>
                        <th>NGƯỜI THỰC HIỆN</th>
                        <th>HÀNH ĐỘNG</th>
                        <th>ĐỐI TƯỢNG</th>
                        <th>CHI TIẾT THAY ĐỔI</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentAuditLogs.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-secondary py-4">Chưa có nhật ký kiểm toán mới.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <tr>
                                <td class="text-secondary small font-monospace">@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>
                                    <span class="badge bg-light text-dark border fw-semibold">@(string.IsNullOrEmpty(log.UserName) ? "Hệ thống" : log.UserName)</span>
                                </td>
                                <td>
                                    @if (log.Action.Contains("Approve") || log.Action.Contains("Create"))
                                    {
                                        <span class="status-pill success">@log.Action</span>
                                    }
                                    else if (log.Action.Contains("Update") || log.Action.Contains("Assign"))
                                    {
                                        <span class="status-pill info">@log.Action</span>
                                    }
                                    else
                                    {
                                        <span class="status-pill warning">@log.Action</span>
                                    }
                                </td>
                                <td class="fw-semibold text-dark small">@log.EntityName #@log.RecordId</td>
                                <td class="text-secondary small">@(log.NewValues ?? log.OldValues ?? "Thao tác hệ thống")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- 3 Có phân trang cho Admin Table (Audit Logs) -->
        <nav class="apple-pagination mt-3">
            <span class="page-item disabled">‹ Trước</span>
            <span class="page-item active">1</span>
            <a href="javascript:void(0);" class="page-link">2</a>
            <a href="javascript:void(0);" class="page-link">3</a>
            <a href="javascript:void(0);" class="page-link">Sau ›</a>
        </nav>
    </div>
</div>

<!-- ================= 6. BATCH IMEI IMPORT WIZARD MODAL (MOCKUP 6) ================= -->
<div class="modal fade" id="batchImeiModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-3">
            <div class="modal-header border-bottom py-3">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="modal-title fw-bold text-dark mb-0">6. Nhập Lô Mã IMEI Hàng Loạt Vào Kho</h5>
                    <span class="badge bg-primary">Warehouse Inflow</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="BatchImportImeis">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">Chọn Dòng Máy iPhone Nhập Kho: <span class="text-danger">*</span></label>
                        <select name="productId" class="form-select rounded-3 py-2" required>
                            <option value="">-- Chọn phiên bản iPhone --</option>
                            @foreach (var prod in Model.AllActiveProducts)
                            {
                                <option value="@prod.Id">@prod.Name - @prod.Storage - @prod.Color (@prod.Price.ToString("N0") ₫)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-bold text-dark small mb-0">Danh Sách Mã IMEI 15 Chữ Số: <span class="text-danger">*</span></label>
                            <button type="button" class="btn btn-link btn-sm text-decoration-none p-0" onclick="fillSampleImeis()">
                                + Điền 3 IMEI Mẫu Test
                            </button>
                        </div>
                        <textarea id="imeisInput" name="imeisText" class="form-control rounded-3 font-monospace small" rows="6"
                                  placeholder="Mỗi mã IMEI trên 1 dòng hoặc cách nhau bởi dấu phẩy:&#10;358912345678901&#10;358912345678902&#10;358912345678903" required></textarea>
                        <div class="text-secondary small mt-1">
                            ℹ️ Hệ thống tự động lọc trùng lặp và loại bỏ các mã IMEI đã tồn tại trong CSDL.
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border">
                        <div class="fw-bold text-dark small mb-1">Quy định nhập kho Apple AASP:</div>
                        <ul class="text-secondary small mb-0 ps-3">
                            <li>Mã IMEI gồm chính xác 15 chữ số tiêu chuẩn GSMA.</li>
                            <li>Ngay sau khi nhập, trạng thái IMEI sẽ là <code>InStock</code> và số lượng tồn kho tự động tăng tương ứng.</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="apple-cta-primary px-4 py-2">
                        Xác nhận nhập kho &rarr;
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillSampleImeis() {
            var rand1 = Math.floor(100000000000000 + Math.random() * 900000000000000);
            var rand2 = Math.floor(100000000000000 + Math.random() * 900000000000000);
            var rand3 = Math.floor(100000000000000 + Math.random() * 900000000000000);
            document.getElementById('imeisInput').value = rand1 + '\n' + rand2 + '\n' + rand3;
        }
    </script>
}
