@page
@model IPhoneStore_Razor.Pages.Admin.BatchImportModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nhập lô IMEI Apple Authorized";
}

<div class="aar-topbar-title-section mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-page="/Admin/Inventory" class="text-secondary text-decoration-none small">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Quay lại Kho IMEI
        </a>
    </div>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 fw-bold mb-0">Nhập Lô IMEI Từ Nhà Phân Phối Ủy Quyền Apple</h1>
            <p class="text-secondary small mb-0">Hỗ trợ đối soát và kiểm tra định dạng 15 số chuẩn GSX của Apple</p>
        </div>
    </div>
</div>

<!-- 3-STEP VISUAL STEPPER -->
<div class="aar-stepper mb-4">
    <div class="aar-step active">
        <div class="aar-step-circle">1</div>
        <div class="aar-step-label">Chọn Model &amp; Đối tác NCC</div>
    </div>
    <div class="aar-step active">
        <div class="aar-step-circle">2</div>
        <div class="aar-step-label">Dán / Quét Danh sách IMEI</div>
    </div>
    <div class="aar-step">
        <div class="aar-step-circle">3</div>
        <div class="aar-step-label">Kiểm tra hợp lệ &amp; Nhập kho</div>
    </div>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger py-2 px-3 small rounded-3 mb-4 d-flex align-items-center gap-2">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>@Model.ErrorMessage</span>
    </div>
}

<form method="post">
    <div class="row g-4">
        <!-- Cột trái: Form nhập liệu -->
        <div class="col-lg-8">
            <div class="aar-card mb-4">
                <div class="aar-card-header">
                    <div class="fw-bold fs-6">Bước 1 &amp; 2: Thông tin Lô Hàng &amp; Dữ liệu IMEI</div>
                </div>
                <div class="aar-card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Sản phẩm tiếp nhận <span class="text-danger">*</span></label>
                            <select asp-for="Vm.SelectedProductId" class="form-select form-select-sm" required id="productSelector">
                                <option value="">-- Chọn dòng iPhone tiếp nhận lô --</option>
                                @foreach (var p in Model.Vm.Products)
                                {
                                    <option value="@p.Id" data-sku="@p.Sku" data-stock="@p.Quantity">
                                        @p.Name (@p.Sku) - Tồn hiện tại: @p.Quantity
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Nhà phân phối ủy quyền (Distributor)</label>
                            <select asp-for="Vm.Vendor" class="form-select form-select-sm">
                                <option value="Synnex FPT">Synnex FPT (Nhà phân phối chính thức)</option>
                                <option value="DGW - Digiworld">DGW (Digiworld Corporation)</option>
                                <option value="Petrosetco">Petrosetco (PSD)</option>
                                <option value="Viettel Commerce">Viettel Commerce</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Ghi chú số hóa đơn / PO đối tác</label>
                        <input asp-for="Vm.Note" class="form-control form-control-sm" placeholder="VD: Hóa đơn GTGT Synnex số VAT-2026/0912" />
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-semibold mb-0">
                                Danh sách số IMEI (15 số / mỗi dòng một mã) <span class="text-danger">*</span>
                            </label>
                            <span class="badge bg-secondary small" id="imeiCountBadge">0 IMEI đã phát hiện</span>
                        </div>
                        <textarea asp-for="Vm.ImeisText" id="imeisInput" class="form-control form-control-sm font-monospace" rows="10" 
                                  placeholder="358941091234567&#10;358941091234568&#10;358941091234569"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-page="/Admin/Inventory" class="aar-btn aar-btn-outline">Hủy bỏ</a>
                        <button type="submit" class="aar-btn aar-btn-primary">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" y1="15" x2="12" y2="3"></line>
                            </svg>
                            Xác thực &amp; Lưu Lô Hàng
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Hướng dẫn & Tiêu chuẩn Apple -->
        <div class="col-lg-4">
            <div class="aar-card mb-4">
                <div class="aar-card-header">
                    <div class="fw-bold fs-6">Quy chuẩn GSX Apple</div>
                </div>
                <div class="aar-card-body small">
                    <div class="d-flex align-items-start gap-2 mb-3">
                        <div class="text-success mt-1">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <div>
                            <strong>Độ dài bắt buộc 15 chữ số:</strong> Hệ thống tự động từ chối nếu có ký tự chữ hoặc độ dài khác 15 ký tự.
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-2 mb-3">
                        <div class="text-success mt-1">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <div>
                            <strong>Chống trùng lặp tuyệt đối:</strong> Kiểm tra tức thời cả trong danh sách nhập và trong toàn bộ kho dữ liệu.
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-2">
                        <div class="text-success mt-1">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <div>
                            <strong>Cập nhật tồn kho tự động:</strong> Ngay khi lưu thành công, số lượng tồn kho `Products.Quantity` sẽ tự động tăng tương ứng.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const input = document.getElementById("imeisInput");
        const badge = document.getElementById("imeiCountBadge");
        if (input && badge) {
            input.addEventListener("input", function() {
                const lines = input.value.split(/\r?\n/).map(l => l.trim()).filter(l => l.length > 0);
                badge.textContent = lines.length + " IMEI đã phát hiện";
            });
        }
    });
</script>
}
