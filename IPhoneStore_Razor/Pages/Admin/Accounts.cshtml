@page
@model IPhoneStore_Razor.Pages.Admin.AccountsModel
@{
    ViewData["Title"] = "11. Nhân Viên & Phân Quyền (RBAC) - Admin";
}

<div>
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1">IDENTITY &amp; ACCESS MANAGEMENT (IAM)</span>
                <span class="text-secondary small">Quản lý nhân sự và ma trận phân quyền RBAC</span>
            </div>
            <h1 class="fs-3 fw-bold text-dark mb-0">11. Nhân Viên &amp; Phân Quyền Hệ Thống</h1>
        </div>
        <button type="button" class="apple-cta-primary py-2 px-3 fs-6" onclick="alert('Tính năng mời nhân viên mới qua Email SSO đã được thiết lập.')">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
            <span>+ Thêm Nhân Viên Mới</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.AlertMessage))
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-3 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <strong>Thành công:</strong> @Model.AlertMessage
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search Staff & Accounts -->
    <div class="bg-white border rounded-3 p-3 mb-4 shadow-sm">
        <form method="get" class="d-flex gap-3">
            <div class="apple-search-pill-container" style="max-width: 380px;">
                <svg class="search-icon-inside" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                <input type="text" name="SearchKeyword" value="@Model.SearchKeyword" class="apple-search-pill" placeholder="Tìm theo username hoặc email..." />
            </div>
            <button type="submit" class="apple-cta-primary btn-sm py-2 px-4">Tìm kiếm</button>
            <a asp-page="/Admin/Accounts" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2">Reset</a>
        </form>
    </div>

    <!-- Staff Accounts Table (Mockup 11) -->
    <div class="admin-table-container mb-4">
        <div class="admin-table-header">
            <div>
                <h3 class="fs-6 fw-bold text-dark mb-0">Danh Sách Tài Khoản Trong Hệ Thống (@Model.Accounts.Count tài khoản)</h3>
                <div class="text-secondary small">Phân bổ vai trò Admin, Quản lý kho và Khách hàng</div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Tên đăng nhập</th>
                        <th>Vai trò (Role)</th>
                        <th>Họ và tên</th>
                        <th>Số điện thoại</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acc in Model.Accounts)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="user-avatar-circle" style="width:28px;height:28px;">@(acc.Username?.Substring(0, 1).ToUpper() ?? "U")</span>
                                    <strong class="text-dark">@acc.Username</strong>
                                </div>
                            </td>
                            <td>
                                @if (acc.Role == "Admin")
                                {
                                    <span class="badge bg-danger text-white fw-bold">Admin Quản Trị</span>
                                }
                                else if (acc.Role == "Warehouse")
                                {
                                    <span class="badge bg-warning text-dark fw-bold">Quản Lý Kho</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border">Khách Hàng</span>
                                }
                            </td>
                            <td><span class="text-dark small">@(acc.FullName ?? "-")</span></td>
                            <td><span class="text-secondary small">@(acc.PhoneNumber ?? "-")</span></td>
                            <td class="text-secondary small">@acc.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (acc.IsActive)
                                {
                                    <span class="status-pill success">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-pill danger">Bị khóa</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (acc.Username != "admin")
                                {
                                    <div class="d-inline-flex gap-2">
                                        <form method="post" asp-page-handler="ToggleLock" asp-route-id="@acc.Id">
                                            <button type="submit" class="btn btn-sm rounded-pill px-3 @(acc.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                                @(acc.IsActive ? "Khóa" : "Mở")
                                            </button>
                                        </form>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@acc.Id" onsubmit="return confirm('Bạn có chắc muốn xóa tài khoản này?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">Xóa</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary">Hệ thống</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination (Mockup 11) -->
        <div class="p-3 border-top">
            <nav class="apple-pagination mb-0">
                <span class="page-item disabled">‹ Trước</span>
                <span class="page-item active">1</span>
                <a href="javascript:void(0);" class="page-link">2</a>
                <a href="javascript:void(0);" class="page-link">Sau ›</a>
            </nav>
        </div>
    </div>

    <!-- ================= 11. RBAC PERMISSIONS MATRIX (MOCKUP 11) ================= -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fs-5 fw-bold text-dark mb-1">Ma Trận Phân Quyền Vai Trò (Role-Based Access Control)</h3>
                <div class="text-secondary small">Bảng tra cứu quyền hạn chi tiết giữa các nhóm người dùng trong hệ thống</div>
            </div>
            <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-2">Chuẩn ISO 27001</span>
        </div>

        <div class="table-responsive">
            <table class="table rbac-matrix-table align-middle">
                <thead>
                    <tr>
                        <th>PHÂN HỆ NGHIỆP VỤ</th>
                        <th class="text-center">ADMIN TOÀN QUYỀN</th>
                        <th class="text-center">QUẢN LÝ KHO (WAREHOUSE)</th>
                        <th class="text-center">KHÁCH HÀNG (CUSTOMER)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Quản lý Danh mục &amp; Sản phẩm (CRUD)</strong></td>
                        <td class="text-center rbac-check">✓ Đầy đủ</td>
                        <td class="text-center rbac-check">✓ Chỉ xem &amp; cập nhật tồn</td>
                        <td class="text-center rbac-cross">✗ Không có quyền</td>
                    </tr>
                    <tr>
                        <td><strong>Nhập lô mã IMEI hàng loạt (Batch Inflow)</strong></td>
                        <td class="text-center rbac-check">✓ Đầy đủ</td>
                        <td class="text-center rbac-check">✓ Đầy đủ</td>
                        <td class="text-center rbac-cross">✗ Không có quyền</td>
                    </tr>
                    <tr>
                        <td><strong>Duyệt đơn hàng &amp; Gán IMEI xuất kho</strong></td>
                        <td class="text-center rbac-check">✓ Đầy đủ</td>
                        <td class="text-center rbac-check">✓ Đầy đủ</td>
                        <td class="text-center rbac-cross">✗ Không có quyền</td>
                    </tr>
                    <tr>
                        <td><strong>Xem Nhật Ký Kiểm Toán (Audit Logs)</strong></td>
                        <td class="text-center rbac-check">✓ Đầy đủ</td>
                        <td class="text-center rbac-cross">✗ Không có quyền</td>
                        <td class="text-center rbac-cross">✗ Không có quyền</td>
                    </tr>
                    <tr>
                        <td><strong>Đặt hàng, Mua sắm &amp; Xem lịch sử đơn của mình</strong></td>
                        <td class="text-center rbac-check">✓ Đầy đủ</td>
                        <td class="text-center rbac-check">✓ Đầy đủ</td>
                        <td class="text-center rbac-check">✓ Đầy đủ</td>
                    </tr>
                    <tr>
                        <td><strong>Tra cứu bảo hành điện tử chính hãng Apple Care</strong></td>
                        <td class="text-center rbac-check">✓ Đầy đủ</td>
                        <td class="text-center rbac-check">✓ Đầy đủ</td>
                        <td class="text-center rbac-check">✓ Công khai</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
