@page
@model IPhoneStore_Razor.Pages.Admin.InventoryModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kho IMEI & Serial Number";
}

<div class="aar-topbar-title-section mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 fw-bold mb-0">Kho IMEI &amp; Serial Number Apple</h1>
            <p class="text-secondary small mb-0">Hệ thống quản lý vòng đời từng chiếc iPhone theo định danh vật lý duy nhất</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Admin/BatchImport" class="aar-btn aar-btn-primary">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Nhập Lô IMEI Mới
            </a>
        </div>
    </div>
</div>

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        <span>@Model.SuccessMessage</span>
    </div>
}

<!-- 4 THẺ CHỈ SỐ KHO HÀNG -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="aar-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-medium">Sẵn sàng xuất bán</span>
                <span class="aar-pill aar-pill-success">Tồn kho</span>
            </div>
            <div class="h2 fw-bold text-success mb-0">@Model.Vm.InStockCount</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Máy mới 100% nguyên seal</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="aar-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-medium">Đang giữ cho đơn hàng</span>
                <span class="aar-pill aar-pill-warning">Tạm giữ</span>
            </div>
            <div class="h2 fw-bold text-warning mb-0">@Model.Vm.ReservedCount</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Đang chờ khách thanh toán / vận chuyển</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="aar-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-medium">Đã xuất kho khách lẻ</span>
                <span class="aar-pill aar-pill-info">Đã bán</span>
            </div>
            <div class="h2 fw-bold text-info mb-0">@Model.Vm.SoldCount</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Đã kích hoạt bảo hành điện tử</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="aar-card p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-secondary small fw-medium">Lỗi chờ Apple xử lý</span>
                <span class="aar-pill aar-pill-danger">Lỗi phần cứng</span>
            </div>
            <div class="h2 fw-bold text-danger mb-0">@Model.Vm.DefectiveCount</div>
            <div class="text-muted small" style="font-size: 0.72rem;">Khóa xuất kho &amp; cách ly</div>
        </div>
    </div>
</div>

<!-- CẢNH BÁO TỒN KHO <= 5 CHIẾC -->
@if (Model.Vm.LowStockProducts.Any())
{
    <div class="alert alert-warning border-warning rounded-3 p-3 mb-4 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <div class="p-2 bg-warning bg-opacity-25 rounded-circle text-warning">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                    <line x1="12" y1="9" x2="12" y2="13"></line>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
            </div>
            <div>
                <div class="fw-bold text-dark">Cảnh báo An toàn Kho AAR: Có @Model.Vm.LowStockProducts.Count mã iPhone tồn kho &le; 5 máy!</div>
                <div class="small text-secondary">
                    @string.Join(" • ", Model.Vm.LowStockProducts.Take(4).Select(p => $"{p.Name} (Còn {p.Quantity})"))
                </div>
            </div>
        </div>
        <a asp-page="/Admin/BatchImport" class="aar-btn aar-btn-primary btn-sm text-nowrap">Tạo Phiếu Nhập Hàng</a>
    </div>
}

<!-- THANH CÔNG CỤ TÌM KIẾM & BỘ LỌC -->
<div class="aar-card mb-4">
    <div class="aar-card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="searchKeyword" value="@Model.Vm.SearchKeyword" class="form-control form-control-sm" placeholder="Tìm kiếm theo 15 số IMEI, Serial Number hoặc tên máy..." />
            </div>
            <div class="col-md-3">
                <select name="skuFilter" class="form-select form-select-sm">
                    <option value="">-- Tất cả SKU Sản phẩm --</option>
                    @foreach (var p in Model.Vm.AllProducts.Where(p => !string.IsNullOrEmpty(p.Sku)))
                    {
                        <option value="@p.Sku" selected="@(Model.Vm.SkuFilter == p.Sku)">@p.Sku - @p.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="statusFilter" class="form-select form-select-sm">
                    <option value="">-- Mọi trạng thái IMEI --</option>
                    <option value="InStock" selected="@(Model.Vm.StatusFilter == "InStock")">Sẵn sàng bán (InStock)</option>
                    <option value="Reserved" selected="@(Model.Vm.StatusFilter == "Reserved")">Đang giữ chỗ (Reserved)</option>
                    <option value="Sold" selected="@(Model.Vm.StatusFilter == "Sold")">Đã xuất bán (Sold)</option>
                    <option value="Defective" selected="@(Model.Vm.StatusFilter == "Defective")">Lỗi kỹ thuật (Defective)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="aar-btn aar-btn-outline w-100 btn-sm">Lọc</button>
                <a asp-page="/Admin/Inventory" class="btn btn-sm btn-light border">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DANH SÁCH IMEI & SERIAL -->
<div class="aar-card">
    <div class="aar-card-header">
        <div class="fw-bold fs-6">Danh sách Chi tiết Mã IMEI / Serial Number (@Model.Vm.TotalCount kết quả)</div>
        <span class="small text-secondary">Được quản lý theo tiêu chuẩn GSX Apple</span>
    </div>
    <div class="table-responsive">
        <table class="aar-table table mb-0">
            <thead>
                <tr>
                    <th style="width: 170px;">MÃ IMEI (15 SỐ)</th>
                    <th>SERIAL NUMBER</th>
                    <th>DÒNG MÁY / SKU</th>
                    <th>NGÀY NHẬP</th>
                    <th>TRẠNG THÁI</th>
                    <th class="text-end">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Vm.Imeis.Any())
                {
                    @foreach (var item in Model.Vm.Imeis)
                    {
                        <tr>
                            <td>
                                <span class="font-monospace fw-bold text-primary">@item.Imei</span>
                            </td>
                            <td>
                                <span class="font-monospace text-secondary">@(string.IsNullOrEmpty(item.SerialNumber) ? "N/A" : item.SerialNumber)</span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@(item.Product?.Name ?? "N/A")</div>
                                <div class="text-secondary small font-monospace">@(item.Product?.Sku ?? "N/A")</div>
                            </td>
                            <td>
                                <div class="small">@item.ImportDate.ToString("dd/MM/yyyy")</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@item.ImportDate.ToString("HH:mm")</div>
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case "InStock":
                                        <span class="aar-pill aar-pill-success">Tồn kho khả dụng</span>
                                        break;
                                    case "Reserved":
                                        <span class="aar-pill aar-pill-warning">Tạm giữ đơn hàng</span>
                                        break;
                                    case "Sold":
                                        <span class="aar-pill aar-pill-info">Đã bán lẻ</span>
                                        break;
                                    case "Defective":
                                        <span class="aar-pill aar-pill-danger">Lỗi phần cứng</span>
                                        break;
                                    default:
                                        <span class="aar-pill aar-pill-secondary">@item.Status</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown d-inline-block">
                                    <button class="btn btn-sm btn-light border py-1 px-2" type="button" data-bs-toggle="dropdown">
                                        Đổi trạng thái
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm small">
                                        <li>
                                            <form method="post" asp-page-handler="UpdateImeiStatus">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="status" value="InStock" />
                                                <button type="submit" class="dropdown-item text-success">Sẵn sàng bán (InStock)</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form method="post" asp-page-handler="UpdateImeiStatus">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="status" value="Defective" />
                                                <button type="submit" class="dropdown-item text-danger">Báo máy lỗi (Defective)</button>
                                            </form>
                                        </li>
                                        <li>
                                            <form method="post" asp-page-handler="UpdateImeiStatus">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="status" value="Reserved" />
                                                <button type="submit" class="dropdown-item text-warning">Tạm giữ máy (Reserved)</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-secondary">
                            Không tìm thấy dữ liệu IMEI nào phù hợp với bộ lọc tìm kiếm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
