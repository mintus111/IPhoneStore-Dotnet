@page "{id:int?}"
@model IPhoneStore_Razor.Pages.Admin.EditProductModel
@{
    Layout = "_AdminLayout";
    var isNew = Model.Product.Id == 0;
    ViewData["Title"] = isNew ? "Thêm mới iPhone" : $"Chỉnh sửa: {Model.Product.Name}";
}

<div class="aar-topbar-title-section mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <a asp-page="/Admin/Products" class="text-secondary text-decoration-none small">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Quay lại Sản phẩm
        </a>
    </div>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 fw-bold mb-0">@(isNew ? "Thêm mới Sản phẩm iPhone" : $"Cấu hình chi tiết: {Model.Product.Name}")</h1>
            <p class="text-secondary small mb-0">Hệ thống đồng bộ giá bán, thông số kỹ thuật AAR và quản lý danh sách IMEI kho hàng</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Admin/Products" class="aar-btn aar-btn-outline">Hủy bỏ</a>
            <button type="submit" form="editProductForm" class="aar-btn aar-btn-primary">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                    <polyline points="17 21 17 13 7 13 7 21"></polyline>
                    <polyline points="7 3 7 8 15 8"></polyline>
                </svg>
                Lưu cấu hình iPhone
            </button>
        </div>
    </div>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger py-2 px-3 small rounded-3 mb-4 d-flex align-items-center gap-2">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>@Model.ErrorMessage</span>
    </div>
}

<form id="editProductForm" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Product.Id" />
    <input type="hidden" asp-for="Product.ImageUrl" />

    <div class="row g-4">
        <!-- Cột trái: Thông tin sản phẩm chính -->
        <div class="col-lg-8">
            <!-- Thẻ 1: Thông tin cơ bản & SKU -->
            <div class="aar-card mb-4">
                <div class="aar-card-header">
                    <div class="fw-bold fs-6">Thông tin Định danh Sản phẩm (AAR SKU)</div>
                    <span class="badge bg-light text-dark border">Bắt buộc</span>
                </div>
                <div class="aar-card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Tên hiển thị thương mại <span class="text-danger">*</span></label>
                            <input asp-for="Product.Name" class="form-control form-control-sm" placeholder="VD: iPhone 16 Pro Max 256GB Titan Sa Mạc" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Mã định danh SKU Apple <span class="text-danger">*</span></label>
                            <input asp-for="Product.Sku" id="inputProductSku" class="form-control form-control-sm font-monospace" placeholder="VD: IP16PM-256-DES" required />
                            <div id="skuFeedback" class="small mt-1" style="min-height: 1.25rem;"></div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Phân loại Dòng máy <span class="text-danger">*</span></label>
                            <select asp-for="Product.CategoryId" class="form-select form-select-sm" required>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Model Series <span class="text-danger">*</span></label>
                            <input asp-for="Product.ModelSeries" class="form-control form-control-sm" placeholder="VD: iPhone 16 Pro Max" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold">Dung lượng</label>
                            <select asp-for="Product.Storage" class="form-select form-select-sm">
                                <option value="128GB">128GB</option>
                                <option value="256GB">256GB</option>
                                <option value="512GB">512GB</option>
                                <option value="1TB">1TB</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-semibold">Màu sắc</label>
                            <input asp-for="Product.Color" class="form-control form-control-sm" placeholder="VD: Titan Tự Nhiên" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thẻ 2: Giá & Chính sách AAR -->
            <div class="aar-card mb-4">
                <div class="aar-card-header">
                    <div class="fw-bold fs-6">Chính sách Giá &amp; Bảo hành Ủy quyền AAR</div>
                </div>
                <div class="aar-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Giá bán thực tế (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="Product.Price" type="number" step="10000" class="form-control form-control-sm text-end fw-bold text-primary" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Giá niêm yết Apple Store</label>
                            <input asp-for="Product.ListedPrice" type="number" step="10000" class="form-control form-control-sm text-end" placeholder="Để trống nếu = Giá bán" />
                            <div class="text-secondary" style="font-size: 0.72rem;">Dùng để tính % giảm giá trên web</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Thời hạn Bảo hành chính hãng</label>
                            <div class="input-group input-group-sm">
                                <input asp-for="Product.WarrantyMonths" type="number" class="form-control" />
                                <span class="input-group-text">Tháng</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thẻ 3: Thông số kỹ thuật Apple & Mô tả -->
            <div class="aar-card mb-4">
                <div class="aar-card-header">
                    <div class="fw-bold fs-6">Thông số Kỹ thuật &amp; Mô tả Chi tiết</div>
                </div>
                <div class="aar-card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Thông số kỹ thuật chuẩn Apple (Specs)</label>
                        <textarea asp-for="Product.Specifications" class="form-control form-control-sm font-monospace" rows="4" 
                                  placeholder="Màn hình: 6.9 inch Super Retina XDR OLED, ProMotion 120Hz&#10;Chip: Apple A18 Pro 3nm&#10;Camera: 48MP Fusion + 48MP Ultra Wide + 12MP 5x Telephoto"></textarea>
                    </div>
                    <div>
                        <label class="form-label small fw-semibold">Mô tả sản phẩm (Bài viết giới thiệu)</label>
                        <textarea asp-for="Product.Description" class="form-control form-control-sm" rows="5" placeholder="Giới thiệu về dòng sản phẩm iPhone mới nhất..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Hình ảnh & Quản lý Kho -->
        <div class="col-lg-4">
            <!-- Thẻ Hình ảnh -->
            <div class="aar-card mb-4">
                <div class="aar-card-header">
                    <div class="fw-bold fs-6">Hình ảnh Sản phẩm</div>
                </div>
                <div class="aar-card-body text-center">
                    <div class="mb-3 border rounded-3 p-3 bg-light d-flex align-items-center justify-content-center" style="min-height: 200px;">
                        @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                        {
                            <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" style="max-height: 180px; max-width: 100%; object-fit: contain;" />
                        }
                        else
                        {
                            <div class="text-secondary small">
                                <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" class="mb-2 text-muted">
                                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                                    <polyline points="21 15 16 10 5 21"></polyline>
                                </svg>
                                <div>Chưa có ảnh tải lên</div>
                            </div>
                        }
                    </div>
                    <label class="form-label small fw-semibold d-block text-start">Tải ảnh mới từ máy tính</label>
                    <input type="file" name="imageFile" class="form-control form-control-sm" accept="image/*" />
                </div>
            </div>

            <!-- Thẻ Trạng thái kinh doanh & Tồn kho -->
            <div class="aar-card mb-4">
                <div class="aar-card-header">
                    <div class="fw-bold fs-6">Trạng thái &amp; Tồn kho</div>
                </div>
                <div class="aar-card-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Số lượng tồn kho (Khả dụng)</label>
                        <input asp-for="Product.Quantity" type="number" class="form-control form-control-sm text-end fw-bold" />
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input asp-for="Product.IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch">
                        <label class="form-check-label small fw-semibold" for="isActiveSwitch">
                            Hiển thị mở bán trên Website
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function () {
    const skuInput = document.getElementById('inputProductSku');
    const feedback = document.getElementById('skuFeedback');
    const form = document.getElementById('editProductForm');
    const productId = @(Model.Product.Id);
    let timeout = null;
    let isSkuValid = true;

    function checkSku() {
        const val = skuInput.value.trim();
        if (!val) {
            feedback.innerHTML = '<span class="text-danger fw-semibold">⚠️ Mã SKU không được để trống!</span>';
            skuInput.classList.add('is-invalid');
            skuInput.classList.remove('is-valid');
            isSkuValid = false;
            return;
        }

        feedback.innerHTML = '<span class="text-secondary"><span class="spinner-border spinner-border-sm me-1" style="width: 0.85rem; height: 0.85rem;"></span>Đang kiểm tra SKU...</span>';

        fetch(`/Admin/CheckSkuAvailability?sku=${encodeURIComponent(val)}&productId=${productId}`)
            .then(res => res.json())
            .then(data => {
                if (data.available) {
                    feedback.innerHTML = `<span class="text-success fw-semibold">${data.message}</span>`;
                    skuInput.classList.remove('is-invalid');
                    skuInput.classList.add('is-valid');
                    isSkuValid = true;
                } else {
                    feedback.innerHTML = `<span class="text-danger fw-semibold">${data.message}</span>`;
                    skuInput.classList.add('is-invalid');
                    skuInput.classList.remove('is-valid');
                    isSkuValid = false;
                }
            })
            .catch(() => {
                feedback.innerHTML = '';
            });
    }

    skuInput.addEventListener('input', function () {
        clearTimeout(timeout);
        timeout = setTimeout(checkSku, 350);
    });

    skuInput.addEventListener('blur', function () {
        checkSku();
    });

    form.addEventListener('submit', function (e) {
        if (!isSkuValid) {
            e.preventDefault();
            skuInput.focus();
            alert('Mã SKU không hợp lệ hoặc đã tồn tại trong hệ thống! Vui lòng kiểm tra lại trước khi lưu.');
        }
    });
});
</script>
}
