@page
@model IPhoneStore_Razor.Pages.Admin.StaffModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Khách hàng & Tài khoản";
}

<style>
    .aar-compact-table { width: 100%; margin-bottom: 0; }
    .aar-compact-table th {
        padding: 0.75rem 0.65rem !important;
        font-size: 0.74rem !important;
        font-weight: 700;
        letter-spacing: 0.04em;
        white-space: nowrap;
        background: #f8fafc;
        border-bottom: 1px solid var(--aar-border, #e2e8f0);
    }
    .aar-compact-table td {
        padding: 0.7rem 0.65rem !important;
        vertical-align: middle !important;
        font-size: 0.84rem;
        border-bottom: 1px solid var(--aar-border, #e2e8f0);
    }
    .aar-compact-table tr:hover td { background-color: #f8fafc; }
    .btn-action-custom {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        width: 68px !important;
        height: 30px !important;
        min-width: 68px !important;
        padding: 0 !important;
        font-size: 0.76rem !important;
        font-weight: 600 !important;
        border-radius: 6px !important;
        white-space: nowrap !important;
    }
</style>

<div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-2 py-1" style="font-size: 0.68rem; letter-spacing: 0.05em;">CUSTOMER MANAGEMENT</span>
        <span class="text-secondary small">Quản lý định danh và tài khoản khách hàng</span>
    </div>
    <h1 class="h3 fw-bold text-dark mb-1">Quản lý Khách hàng &amp; Tài khoản</h1>
    <p class="text-secondary small mb-0">Hồ sơ thông tin khách hàng Apple AAR, xem chi tiết và chỉnh sửa trực tiếp qua Pop-up, đổi mật khẩu và quản lý khóa/mở tài khoản.</p>
</div>

@if (Model.SuccessMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="alert">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span>@Model.SuccessMessage</span>
        <button type="button" class="btn-close ms-auto p-2" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 py-2 px-3 small d-flex align-items-center gap-2 mb-3" role="alert">
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <span>@Model.ErrorMessage</span>
        <button type="button" class="btn-close ms-auto p-2" data-bs-dismiss="alert"></button>
    </div>
}

<!-- 4 THẺ THỐNG KÊ KPI TRÊN ĐẦU TRANG -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                </div>
                <div>
                    <div class="text-secondary small fw-medium">Tổng khách hàng</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalCustomers <span class="fs-6 fw-normal text-muted">người</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div>
                    <div class="text-secondary small fw-medium">Tài khoản hoạt động</div>
                    <div class="fs-4 fw-bold text-success">@Model.ActiveAccounts <span class="fs-6 fw-normal text-muted">tài khoản</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                </div>
                <div>
                    <div class="text-secondary small fw-medium">Tài khoản bị khóa</div>
                    <div class="fs-4 fw-bold text-danger">@Model.LockedAccounts <span class="fs-6 fw-normal text-muted">tài khoản</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border rounded-3 p-3 h-100 shadow-sm bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                </div>
                <div>
                    <div class="text-secondary small fw-medium">Tổng đơn hàng</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalOrders <span class="fs-6 fw-normal text-muted">đơn</span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- BẢNG DANH SÁCH KHÁCH HÀNG -->
<div class="card border rounded-3 shadow-sm bg-white mb-4">
    <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h5 class="fw-bold mb-0">Danh sách Khách hàng (@Model.Customers.Count / @Model.TotalCustomers hồ sơ)</h5>
            <small class="text-secondary">Cập nhật thời gian thực từ cơ sở dữ liệu khách hàng &amp; Identity</small>
        </div>
        <form method="get" class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width: 250px;">
                <input type="text" name="SearchKeyword" value="@Model.SearchKeyword" class="form-control" placeholder="Tên, SĐT, Email, Username...">
            </div>
            <select name="StatusFilter" class="form-select form-select-sm" style="width: 140px;">
                <option value="">Tất cả trạng thái</option>
                <option value="active" selected="@(Model.StatusFilter == "active")">Đang hoạt động</option>
                <option value="locked" selected="@(Model.StatusFilter == "locked")">Bị khóa</option>
            </select>
            <button type="submit" class="btn btn-sm btn-primary px-3">Tìm</button>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table aar-compact-table align-middle">
            <thead>
                <tr>
                    <th style="width: 23%;">Khách hàng &amp; Định danh</th>
                    <th style="width: 20%;">Liên hệ</th>
                    <th style="width: 24%;">Địa chỉ nhận hàng</th>
                    <th style="width: 11%;">Giao dịch</th>
                    <th style="width: 9%;">Trạng thái</th>
                    <th style="width: 13%;" class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-light text-secondary fw-bold d-flex align-items-center justify-content-center border" style="width: 34px; height: 34px; font-size: 0.76rem;">
                                    @(c.FullName.Length > 0 ? c.FullName.Substring(0, Math.Min(2, c.FullName.Length)).ToUpper() : "KH")
                                </div>
                                <div style="line-height: 1.25;">
                                    <div class="fw-bold text-dark">
                                        @c.FullName
                                        <span class="badge bg-light text-secondary border ms-1" style="font-size: 0.65rem;">#KH-@c.Id</span>
                                    </div>
                                    <div class="text-secondary" style="font-size: 0.72rem;">
                                        @if (!string.IsNullOrEmpty(c.UserName))
                                        {
                                            <span class="text-primary fw-medium">@@@c.UserName</span>
                                            <span class="mx-1">•</span>
                                        }
                                        <span>@c.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div style="line-height: 1.3;">
                                <div class="fw-semibold text-dark" style="font-size: 0.78rem;">
                                    <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-danger me-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                    @c.PhoneNumber
                                </div>
                                @if (!string.IsNullOrEmpty(c.Email))
                                {
                                    <div class="text-muted" style="font-size: 0.74rem;">
                                        <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-secondary me-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                        @c.Email
                                    </div>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="text-secondary text-truncate" style="max-width: 230px; font-size: 0.76rem;" title="@c.Address">
                                <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-danger me-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                                @(string.IsNullOrEmpty(c.Address) ? "Chưa cập nhật địa chỉ" : c.Address)
                            </div>
                        </td>
                        <td>
                            <div style="line-height: 1.25; font-size: 0.75rem;">
                                <div class="fw-semibold text-dark">
                                    <span class="text-warning">📦</span> @c.OrderCount đơn
                                </div>
                                <div class="text-secondary">
                                    <span class="text-info">🛡️</span> @c.WarrantyCount bảo hành
                                </div>
                            </div>
                        </td>
                        <td>
                            @if (c.UserId == null)
                            {
                                <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.7rem;">Khách vãng lai</span>
                            }
                            else if (c.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1" style="font-size: 0.7rem;">● Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1" style="font-size: 0.7rem;">● Đã khóa</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-center gap-1">
                                <!-- Nút 1: Chi tiết & Sửa -->
                                <button type="button" class="btn btn-outline-primary btn-action-custom"
                                        onclick="openEditCustomerModal(@c.Id, '@c.FullName', '@c.PhoneNumber', '@c.Email', '@c.Address', '@@@c.UserName', @c.OrderCount, @c.WarrantyCount)">
                                    Chi tiết
                                </button>

                                @if (c.UserId != null)
                                {
                                    <!-- Nút 2: Đổi Mật Khẩu -->
                                    <button type="button" class="btn btn-outline-secondary btn-action-custom"
                                            onclick="openResetPasswordModal('@c.UserId', '@c.FullName', '@@@c.UserName')">
                                        Đổi MK
                                    </button>

                                    <!-- Nút 3: Khóa / Mở Khóa -->
                                    <form method="post" asp-page-handler="ToggleStatus" class="d-inline m-0 p-0" onsubmit="return confirm('@(c.IsActive ? "Bạn có chắc muốn KHÓA tài khoản này?" : "Mở khóa tài khoản này?")');">
                                        <input type="hidden" name="userId" value="@c.UserId" />
                                        @if (c.IsActive)
                                        {
                                            <button type="submit" class="btn btn-outline-warning btn-action-custom text-warning">Khóa</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-action-custom text-success">Mở</button>
                                        }
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL 1: XEM CHI TIẾT & CHỈNH SỬA THÔNG TIN KHÁCH HÀNG -->
<div class="modal fade" id="editCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-dark mb-1">Hồ sơ khách hàng &amp; Chỉnh sửa</h5>
                    <p class="text-secondary small mb-0" id="modalCustomerSubtitle">Hồ sơ khách hàng Apple AAR</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editCustomerForm" method="post" asp-page-handler="EditCustomer">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editCustomerId" name="id" />
                <div class="modal-body px-4 py-3">
                    <div id="modalAlertError" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-none"></div>

                    <!-- Lịch sử tóm tắt -->
                    <div class="row g-2 mb-3 p-3 bg-light rounded-3">
                        <div class="col-sm-4">
                            <span class="text-muted small">Tài khoản đăng nhập:</span>
                            <div class="fw-bold text-primary" id="viewAccountUsername">-</div>
                        </div>
                        <div class="col-sm-4">
                            <span class="text-muted small">Đơn hàng đã đặt:</span>
                            <div class="fw-bold text-dark" id="viewOrderCount">0 đơn</div>
                        </div>
                        <div class="col-sm-4">
                            <span class="text-muted small">Thiết bị bảo hành:</span>
                            <div class="fw-bold text-info" id="viewWarrantyCount">0 máy</div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Họ và tên khách hàng <span class="text-danger">*</span></label>
                            <input type="text" id="editFullName" name="fullName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Số điện thoại di động <span class="text-danger">*</span></label>
                            <input type="tel" id="editPhoneNumber" name="phoneNumber" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Địa chỉ Email</label>
                            <input type="email" id="editEmail" name="email" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Địa chỉ giao hàng mặc định</label>
                            <textarea id="editAddress" name="address" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" id="btnSubmitEdit" class="btn btn-primary px-4 fw-semibold">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 2: CẤP LẠI MẬT KHẨU -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <h5 class="modal-title fw-bold text-dark">Cấp lại mật khẩu khách hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="ResetPassword">
                @Html.AntiForgeryToken()
                <input type="hidden" id="resetUserId" name="userId" />
                <div class="modal-body px-4 py-3">
                    <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3">
                        Cấp lại mật khẩu sẽ hủy toàn bộ phiên đăng nhập hiện tại của khách hàng.
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-1">Khách hàng</label>
                        <div class="fw-bold fs-6 text-dark" id="resetCustomerName">---</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Mật khẩu mới (tối thiểu 8 ký tự, có ký tự đặc biệt) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="text" id="newPasswordInput" name="newPassword" class="form-control" required minlength="8" />
                            <button type="button" class="btn btn-outline-secondary" onclick="generateRandomPassword()">Tạo tự động</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-light px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Xác nhận cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openEditCustomerModal(id, fullName, phone, email, address, username, orderCount, warrantyCount) {
        document.getElementById('editCustomerId').value = id;
        document.getElementById('editFullName').value = fullName;
        document.getElementById('editPhoneNumber').value = phone;
        document.getElementById('editEmail').value = email || '';
        document.getElementById('editAddress').value = address || '';
        document.getElementById('viewAccountUsername').textContent = username || 'Chưa liên kết tài khoản';
        document.getElementById('viewOrderCount').textContent = orderCount + ' đơn';
        document.getElementById('viewWarrantyCount').textContent = warrantyCount + ' máy';
        document.getElementById('modalCustomerSubtitle').textContent = 'Hồ sơ mã số #KH-' + id + ' (' + fullName + ')';
        
        var alertBox = document.getElementById('modalAlertError');
        alertBox.classList.add('d-none');
        alertBox.textContent = '';

        new bootstrap.Modal(document.getElementById('editCustomerModal')).show();
    }

    function openResetPasswordModal(userId, fullName, username) {
        document.getElementById('resetUserId').value = userId;
        document.getElementById('resetCustomerName').textContent = fullName + ' (' + username + ')';
        document.getElementById('newPasswordInput').value = 'Customer@@123';
        new bootstrap.Modal(document.getElementById('resetPasswordModal')).show();
    }

    function generateRandomPassword() {
        var chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@@#$%^&*';
        var pwd = 'Apple@@';
        for (var i = 0; i < 6; i++) {
            pwd += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        document.getElementById('newPasswordInput').value = pwd;
    }

    // Xử lý gửi Form sửa thông tin qua AJAX để hiển thị lỗi Inline ngay trên Modal
    document.getElementById('editCustomerForm').addEventListener('submit', function(e) {
        e.preventDefault();
        var form = this;
        var formData = new FormData(form);
        var alertBox = document.getElementById('modalAlertError');
        var btn = document.getElementById('btnSubmitEdit');

        btn.disabled = true;
        btn.textContent = 'Đang lưu...';
        alertBox.classList.add('d-none');

        fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            btn.disabled = false;
            btn.textContent = 'Lưu thay đổi';
            if (data.success) {
                window.location.reload();
            } else {
                alertBox.textContent = data.message || 'Đã có lỗi xảy ra!';
                alertBox.classList.remove('d-none');
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.textContent = 'Lưu thay đổi';
            form.submit(); // Fallback submit thường nếu fetch gặp sự cố
        });
    });
</script>
