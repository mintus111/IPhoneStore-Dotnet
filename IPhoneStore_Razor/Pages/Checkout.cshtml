@page
@model IPhoneStore_Razor.Pages.CheckoutModel
@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng - BomChelsea (Razor)";
}

<div class="container py-4">
    <!-- Stepper (Mockup 07) -->
    <div class="apple-stepper">
        <div class="stepper-line">
            <div class="stepper-line-progress" style="width: 70%;"></div>
        </div>
        <div class="stepper-step completed">
            <div class="step-circle">✓</div>
            <div class="step-label">Giỏ hàng</div>
        </div>
        <div class="stepper-step completed">
            <div class="step-circle">✓</div>
            <div class="step-label">Tài khoản</div>
        </div>
        <div class="stepper-step active">
            <div class="step-circle">3</div>
            <div class="step-label">Thanh toán</div>
        </div>
        <div class="stepper-step">
            <div class="step-circle">4</div>
            <div class="step-label">Đặt hàng</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-4">
            @Model.ErrorMessage
        </div>
    }

    <form method="post" id="checkoutForm">
        <div class="row g-4">
            <!-- Left Column: Shipping & Payment Details -->
            <div class="col-lg-7">
                <!-- Section 01: Thông tin người nhận -->
                <div class="bg-white border rounded-3 p-4 mb-4 shadow-sm">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-primary text-white rounded-pill px-2 py-1">01</span>
                        <h3 class="fs-5 fw-bold text-dark mb-0">Thông Tin Người Nhận Hàng</h3>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Họ và tên người nhận <span class="text-danger">*</span></label>
                        <input type="text" asp-for="FullName" class="form-control rounded-3 py-2 px-3" placeholder="Ví dụ: Nguyễn Văn A" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Số điện thoại nhận máy <span class="text-danger">*</span></label>
                            <input type="tel" asp-for="PhoneNumber" class="form-control rounded-3 py-2 px-3" placeholder="0901234567" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Email nhận hóa đơn điện tử</label>
                            <input type="email" asp-for="Email" class="form-control rounded-3 py-2 px-3" placeholder="email@gmail.com" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark">Địa chỉ giao hàng chi tiết <span class="text-danger">*</span></label>
                        <input type="text" asp-for="ShippingAddress" class="form-control rounded-3 py-2 px-3" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" required />
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-bold text-dark">Ghi chú giao hàng</label>
                        <textarea asp-for="Notes" class="form-control rounded-3 py-2 px-3" rows="2" placeholder="Giao giờ hành chính, gọi trước khi đến 15 phút..."></textarea>
                    </div>
                </div>

                <!-- Section 02: Hình thức giao hàng -->
                <div class="bg-white border rounded-3 p-4 mb-4 shadow-sm">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-primary text-white rounded-pill px-2 py-1">02</span>
                        <h3 class="fs-5 fw-bold text-dark mb-0">Hình Thức Giao Hàng</h3>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <label class="p-3 border rounded-3 d-flex align-items-center justify-content-between cursor-pointer" style="background:#fcfdff;">
                            <div class="d-flex align-items-center gap-3">
                                <input type="radio" name="shippingMethod" value="Express2H" checked class="form-check-input mt-0" />
                                <div>
                                    <div class="fw-bold text-dark">⚡ Giao siêu tốc 2 Giờ (Nội thành TP.HCM & Hà Nội)</div>
                                    <div class="text-secondary small">Kỹ thuật viên giao tận nhà, hỗ trợ truyền dữ liệu từ iPhone cũ sang máy mới.</div>
                                </div>
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold">MIỄN PHÍ</span>
                        </label>

                        <label class="p-3 border rounded-3 d-flex align-items-center justify-content-between cursor-pointer">
                            <div class="d-flex align-items-center gap-3">
                                <input type="radio" name="shippingMethod" value="Standard" class="form-check-input mt-0" />
                                <div>
                                    <div class="fw-bold text-dark">🚚 Giao hàng tiêu chuẩn toàn quốc (24H - 48H)</div>
                                    <div class="text-secondary small">Vận chuyển qua Giao Hàng Nhanh / Viettel Post có bảo hiểm 100% giá trị máy.</div>
                                </div>
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success fw-bold">MIỄN PHÍ</span>
                        </label>
                    </div>
                </div>

                <!-- Section 03: Phương thức thanh toán (Mockup 07 & 08) -->
                <div class="bg-white border rounded-3 p-4 shadow-sm">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-primary text-white rounded-pill px-2 py-1">03</span>
                        <h3 class="fs-5 fw-bold text-dark mb-0">Phương Thức Thanh Toán</h3>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        <!-- COD -->
                        <label class="p-3 border rounded-3 d-flex align-items-start gap-3 cursor-pointer">
                            <input class="form-check-input mt-1" type="radio" asp-for="PaymentMethod" value="COD" id="payCOD" checked onchange="toggleVietQrSection(false)" />
                            <div>
                                <div class="fw-bold text-dark">Thanh toán khi nhận hàng (COD)</div>
                                <div class="text-secondary small">Kiểm tra tem niêm phong seal máy trước khi thanh toán tiền mặt cho nhân viên giao hàng.</div>
                            </div>
                        </label>

                        <!-- VietQR (Mockup 08) -->
                        <label class="p-3 border rounded-3 d-flex align-items-start gap-3 cursor-pointer" style="border-color:#0071e3 !important;">
                            <input class="form-check-input mt-1" type="radio" asp-for="PaymentMethod" value="BankTransfer" id="payBank" onchange="toggleVietQrSection(true)" />
                            <div class="w-100">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="fw-bold text-primary">Chuyển khoản VietQR tự động 24/7 (Khuyên dùng)</span>
                                    <span class="badge bg-primary text-white small">Xác nhận tức thì</span>
                                </div>
                                <div class="text-secondary small mt-1">Hệ thống tự động kích hoạt giữ chỗ máy trong kho 15 phút.</div>

                                <!-- Dynamic VietQR Card Preview (Mockup 08) -->
                                <div id="vietqr-preview-box" class="mt-3 p-3 bg-light rounded-3 border" style="display:none;">
                                    <div class="vietqr-countdown-banner py-2 px-3 mb-3">
                                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        <span class="small fw-bold">Đơn hàng được giữ chỗ kho trong: <span id="countdown-timer" class="text-danger fw-bold fs-6">15:00</span> phút</span>
                                    </div>

                                    <div class="row align-items-center">
                                        <div class="col-sm-5 text-center mb-3 mb-sm-0">
                                            <img src="https://api.vietqr.io/image/970422-0386789999-b1d5K5w.jpg?accountName=BOMCHELSEA%20APPLE%20RESELLER&amount=@((long)Model.TotalAmount)&addInfo=BOMCHELSEA_ORDER"
                                                 alt="Mã QR Chuyển Khoản" class="img-fluid rounded border bg-white p-2" style="max-height: 180px;" />
                                            <div class="small text-secondary mt-1">Quét bằng App Ngân Hàng bất kỳ</div>
                                        </div>
                                        <div class="col-sm-7 small">
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-secondary">Ngân hàng:</span>
                                                <strong class="text-dark">MB Bank (Quân Đội)</strong>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                                <span class="text-secondary">Số tài khoản:</span>
                                                <div>
                                                    <strong class="text-dark me-1">0386789999</strong>
                                                    <button type="button" class="vietqr-copy-btn" onclick="copyText('0386789999')">Copy</button>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-between py-1 border-bottom">
                                                <span class="text-secondary">Chủ tài khoản:</span>
                                                <strong class="text-dark">CONG TY BOMCHELSEA VN</strong>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center py-1">
                                                <span class="text-secondary">Số tiền:</span>
                                                <div>
                                                    <strong class="text-primary me-1">@Model.TotalAmount.ToString("N0") ₫</strong>
                                                    <button type="button" class="vietqr-copy-btn" onclick="copyText('@((long)Model.TotalAmount)')">Copy</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </label>

                        <!-- Apple Pay & Cards -->
                        <label class="p-3 border rounded-3 d-flex align-items-start gap-3 cursor-pointer">
                            <input class="form-check-input mt-1" type="radio" asp-for="PaymentMethod" value="ApplePay" id="payApple" onchange="toggleVietQrSection(false)" />
                            <div>
                                <div class="fw-bold text-dark">Apple Pay & Thẻ Quốc Tế (Visa / Mastercard)</div>
                                <div class="text-secondary small">Xác thực bảo mật Touch ID / Face ID một chạm an toàn tuyệt đối.</div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Right Column: Sticky Summary & Confirmation -->
            <div class="col-lg-5">
                <div class="bg-white border rounded-3 p-4 shadow-sm position-sticky" style="top: 80px;">
                    <h3 class="fs-5 fw-bold text-dark mb-3">Tóm Tắt Đơn Hàng (@Model.CartItems.Sum(c => c.Quantity) máy)</h3>

                    <!-- Line items list -->
                    <div class="d-flex flex-column gap-3 mb-3 border-bottom pb-3">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://store.storeimages.cdn-apple.com/4982/as-images.apple.com/is/iphone-16-pro-finish-select-202409-6-9inch-deserttitanium?wid=940&hei=1112&fmt=png-alpha" : item.ImageUrl)"
                                         alt="@item.ProductName" style="width: 44px; height: 44px; object-fit: contain;" />
                                    <div>
                                        <div class="text-dark small fw-bold">@item.ProductName</div>
                                        <div class="text-secondary" style="font-size: 0.72rem;">@item.Color · @item.Storage · SL: @item.Quantity</div>
                                    </div>
                                </div>
                                <span class="fw-bold text-dark small">@item.TotalPrice.ToString("N0") ₫</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-secondary">Tạm tính:</span>
                        <span class="fw-semibold text-dark">@Model.TotalAmount.ToString("N0") ₫</span>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-secondary">Phí vận chuyển:</span>
                        <span class="text-success fw-bold">⚡ MIỄN PHÍ</span>
                    </div>

                    <div class="d-flex justify-content-between py-3 my-2">
                        <span class="fs-5 fw-bold text-dark">Tổng cần thanh toán:</span>
                        <div class="text-end">
                            <span class="fs-4 fw-bold text-primary">@Model.TotalAmount.ToString("N0") ₫</span>
                            <div class="text-secondary small">(Đã bao gồm VAT & E-Warranty)</div>
                        </div>
                    </div>

                    <button type="submit" class="apple-cta-primary w-100 py-3 fs-6">
                        Xác Nhận Đặt Hàng &rarr;
                    </button>

                    <div class="mt-4 p-3 bg-light rounded-3 border small text-secondary">
                        <div class="fw-bold text-dark mb-1">Cam kết từ Apple Reseller:</div>
                        Bằng việc bấm "Xác Nhận Đặt Hàng", bạn đồng ý với Điều khoản dịch vụ và Chính sách bảo hành chính hãng 12 tháng tại hệ thống AASP uỷ quyền của Apple.
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function toggleVietQrSection(show) {
            var el = document.getElementById('vietqr-preview-box');
            if (el) {
                el.style.display = show ? 'block' : 'none';
            }
        }

        function copyText(val) {
            navigator.clipboard.writeText(val);
            alert('Đã sao chép: ' + val);
        }

        // 15-Minute Countdown Timer
        var secondsLeft = 15 * 60;
        setInterval(function() {
            var timerEl = document.getElementById('countdown-timer');
            if (timerEl && secondsLeft > 0) {
                secondsLeft--;
                var m = Math.floor(secondsLeft / 60);
                var s = secondsLeft % 60;
                timerEl.innerText = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
            }
        }, 1000);
    </script>
}

