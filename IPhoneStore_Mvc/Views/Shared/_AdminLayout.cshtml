<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BomChelsea Apple Authorized Reseller Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Tooltip & notification adjustments */
        .notification-btn {
            position: relative;
            background: #f1f5f9;
            border: 1px solid var(--aar-border);
            width: 38px;
            height: 38px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #475569;
            transition: all 0.2s;
        }
        .notification-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
        }
        .notification-dot {
            position: absolute;
            top: 7px;
            right: 7px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #ef4444;
            border: 2px solid #ffffff;
        }
    </style>
</head>
<body>
    <div class="aar-admin-wrapper">
        <!-- ================= AAR FIXED SIDEBAR (270px) ================= -->
        <aside class="aar-sidebar">
            <div class="aar-sidebar-brand">
                <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="aar-brand-title d-flex align-items-center gap-2 text-decoration-none">
                    <img src="~/images/chelsea-logo.svg" alt="Chelsea FC" width="28" height="28" class="rounded-circle shadow-sm" style="border: 1px solid #d1ab3e;" />
                    <span class="fw-bold tracking-tight text-white">BomChelsea</span>
                </a>
                <span class="aar-brand-badge" style="background: linear-gradient(135deg, #034694, #0956b5); color: #ffffff; border: 1px solid rgba(255,255,255,0.2);">ADMIN</span>
            </div>

            <nav class="aar-sidebar-nav">
                <div class="aar-nav-section-title">Tổng quan &amp; Kho hàng</div>
                
                <a class="aar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Admin" asp-action="Index">
                    <span>Tổng quan vận hành</span>
                </a>

                <a class="aar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Categories" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Admin" asp-action="Categories">
                    <span>Danh mục dòng máy</span>
                </a>

                <a class="aar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" || ViewContext.RouteData.Values["action"]?.ToString() == "EditProduct" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Admin" asp-action="Products">
                    <span>Sản phẩm &amp; biến thể</span>
                </a>

                <a class="aar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Inventory" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Admin" asp-action="Inventory">
                    <span>Kho IMEI / Serial</span>
                </a>

                <a class="aar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "BatchImport" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Admin" asp-action="BatchImport">
                    <span>Nhập lô IMEI</span>
                    <span class="aar-badge aar-badge-blue">Lô</span>
                </a>

                <div class="aar-nav-section-title mt-2">Bán hàng &amp; Dịch vụ</div>

                <a class="aar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" || ViewContext.RouteData.Values["action"]?.ToString() == "OrderDetail" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Admin" asp-action="Orders">
                    <span>Quản lý Đơn hàng</span>
                    <span class="aar-badge aar-badge-red" id="navOrderBadge">3 mới</span>
                </a>

                <a class="aar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Warranty" || ViewContext.RouteData.Values["action"]?.ToString() == "WarrantyClaimDetail" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Admin" asp-action="Warranty">
                    <span>Bảo hành &amp; 1 Đổi 1</span>
                </a>

                <div class="aar-nav-section-title mt-2">Khách hàng &amp; Hệ thống</div>

                <a class="aar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Staff" || ViewContext.RouteData.Values["action"]?.ToString() == "Customers" || ViewContext.RouteData.Values["action"]?.ToString() == "Accounts" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Admin" asp-action="Staff">
                    <span>Quản lý Khách hàng</span>
                </a>

                <a class="aar-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "AuditLogs" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Admin" asp-action="AuditLogs">
                    <span>Nhật ký kiểm toán</span>
                </a>
            </nav>

            <div class="aar-sidebar-footer">
                <div class="aar-status-indicator">
                    <span class="aar-status-dot"></span>
                    <span>Hệ thống AAR: Đang hoạt động</span>
                </div>
                <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary border-opacity-25">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 text-decoration-none text-light small fw-medium">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                        <span>Cửa hàng bán lẻ</span>
                    </a>
                    <a asp-area="Admin" asp-controller="Account" asp-action="Logout" class="text-danger small" title="Đăng xuất">
                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    </a>
                </div>
            </div>
        </aside>

        <!-- ================= MAIN CONTENT AREA ================= -->
        <main class="aar-main">
            <!-- Topbar -->
            <header class="aar-topbar">
                <div class="aar-breadcrumb">
                    <a asp-area="Admin" asp-controller="Admin" asp-action="Index">BomChelsea Admin</a>
                    <span>/</span>
                    <span class="aar-breadcrumb-current">@(ViewData["Title"] ?? "Vận hành hệ thống")</span>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <!-- Reset Demo Data Button -->
                    <form asp-area="Admin" asp-controller="Admin" asp-action="ResetDemoData" method="post" class="d-inline mb-0" onsubmit="return confirm('⚠️ CẢNH BÁO KHÔI PHỤC DỮ LIỆU:\n\nThao tác này sẽ làm sạch toàn bộ dữ liệu test và nạp lại DỮ LIỆU MẪU CHUẨN AAR (7 sản phẩm, kho IMEI 15 số, 6 đơn hàng đủ 5 trạng thái, hồ sơ bảo hành 1 đổi 1, 5 khách hàng thành viên).\n\nBạn có chắc chắn muốn khôi phục?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill fw-semibold d-flex align-items-center gap-1 shadow-sm px-3" style="font-size: 0.8rem;" title="Khôi phục dữ liệu mẫu chuẩn AAR phục vụ thuyết trình">
                            <span>🔄 Khôi phục Data chuẩn</span>
                        </button>
                    </form>

                    <!-- Quick Search ⌘ K -->
                    <div class="aar-quick-search d-none d-md-block">
                        <svg class="search-icon" width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                        </svg>
                        <input type="text" id="adminQuickSearch" placeholder="Tìm kiếm SKU, IMEI, Đơn hàng..." />
                        <span class="kbd-shortcut">⌘ K</span>
                    </div>

                    <!-- Notification Bell -->
                    <div class="notification-btn" title="Thông báo hệ thống">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                        </svg>
                        <span class="notification-dot"></span>
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="aar-user-profile ps-2 border-start dropdown">
                        <button class="btn p-0 border-0 d-flex align-items-center gap-2 text-decoration-none shadow-none bg-transparent" type="button" id="adminUserDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
                            <div class="aar-avatar-circle" style="background: linear-gradient(135deg, #034694, #0071e3); color: #fff; font-weight: 800;">CP</div>
                            <div class="d-none d-lg-block text-start" style="line-height:1.2;">
                                <div class="fw-bold text-dark small">Cole Palmer</div>
                                <div class="text-muted" style="font-size:0.75rem;">Quản trị viên (Admin) ▾</div>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border py-2" aria-labelledby="adminUserDropdown" style="min-width: 220px; border-radius: 10px;">
                            <li class="px-3 py-2 border-bottom mb-1">
                                <div class="fw-bold text-dark small">Cole Palmer</div>
                                <div class="text-muted font-monospace" style="font-size: 0.72rem;">admin @@ bomchelsea.vn</div>
                            </li>
                            <li>
                                <button class="dropdown-item py-2 d-flex align-items-center gap-2 small" type="button" data-bs-toggle="modal" data-bs-target="#changeAdminPasswordModal">
                                    <span>🔑</span> Đổi mật khẩu Admin
                                </button>
                            </li>
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2 small" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                                    <span>🌐</span> Xem Cửa hàng bán lẻ
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item py-2 d-flex align-items-center gap-2 small text-danger">
                                        <span>🚪</span> Đăng xuất Admin
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Body -->
            <div class="aar-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <div>@TempData["Success"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <div>@TempData["Error"]</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    </div>

    <!-- MODAL ĐỔI MẬT KHẨU TÀI KHOẢN ADMIN -->
    <div class="modal fade" id="changeAdminPasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom pb-3">
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0">Đổi mật khẩu Quản trị viên</h5>
                        <span class="text-muted small">Quy chuẩn bảo mật BRS Mục 2.4.1.4 (Tối thiểu 8 ký tự, 3/4 nhóm)</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-area="Admin" asp-controller="Admin" asp-action="ChangeAdminPassword" method="post" id="changeAdminPasswordForm" onsubmit="return validateAdminChangePassword(event)">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div id="adminPassAlert" class="alert alert-danger d-none align-items-center gap-2 py-2 px-3 small mb-3 border-0 rounded-3 shadow-sm" role="alert">
                            <span id="adminPassAlertMsg" class="fw-medium"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="password" name="currentPassword" id="adminCurrentPassword" class="form-control" required placeholder="Mật khẩu hiện tại (mặc định: admin123)" />
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility('adminCurrentPassword', this)">👁️</button>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small fw-bold">Mật khẩu mới <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="password" name="newPassword" id="adminNewPassword" class="form-control font-monospace" required minlength="8" maxlength="64" 
                                       placeholder="Tối thiểu 8 ký tự (VD: AdminPass@2026)" oninput="evaluateAdminPasswordStrength(this.value)" />
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility('adminNewPassword', this)">👁️</button>
                            </div>
                        </div>

                        <!-- Thanh đo độ mạnh mật khẩu Admin -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted" style="font-size: 0.75rem;">Độ mạnh mật khẩu (BRS):</span>
                                <span id="adminStrengthText" class="badge bg-secondary" style="font-size: 0.7rem;">Chưa nhập</span>
                            </div>
                            <div class="progress" style="height: 6px; border-radius: 3px; background-color: #e9ecef;">
                                <div id="adminStrengthBar" class="progress-bar" role="progressbar" style="width: 0%; transition: width 0.3s ease;"></div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="password" name="confirmPassword" id="adminConfirmPassword" class="form-control font-monospace" required minlength="8" maxlength="64" placeholder="Nhập lại mật khẩu mới" />
                                <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility('adminConfirmPassword', this)">👁️</button>
                            </div>
                        </div>

                        <div class="p-2 bg-blue-50 border border-primary border-opacity-25 rounded-3 small" style="font-size: 0.76rem;">
                            <div class="fw-bold text-primary mb-1">📋 Tiêu chuẩn bảo mật BRS:</div>
                            <div class="text-muted">Độ dài &ge; 8 ký tự, ít nhất 3/4 nhóm (Chữ hoa, thường, số, ký tự đặc biệt). Không dùng mật khẩu yếu.</div>
                        </div>
                    </div>
                    <div class="modal-footer border-top py-2">
                        <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePasswordVisibility(inputId, btn) {
            var input = document.getElementById(inputId);
            if (!input) return;
            input.type = input.type === 'password' ? 'text' : 'password';
            if (btn) {
                btn.innerText = input.type === 'password' ? '👁️' : '🔒';
            }
        }

        function evaluateAdminPasswordStrength(password) {
            const bar = document.getElementById('adminStrengthBar');
            const text = document.getElementById('adminStrengthText');
            if (!bar || !text) return;

            if (!password) {
                bar.style.width = '0%';
                bar.className = 'progress-bar';
                text.className = 'badge bg-secondary';
                text.innerText = 'Chưa nhập';
                return;
            }

            let score = 0;
            if (password.length >= 8) score += 25;
            if (password.length >= 12) score += 15;
            if (/[A-Z]/.test(password)) score += 15;
            if (/[a-z]/.test(password)) score += 15;
            if (/[0-9]/.test(password)) score += 15;
            if (/[!@@#$%^&*()_+\-=\[\]{}|;:,.<>?]/.test(password)) score += 15;

            if (score < 50) {
                bar.style.width = '33%';
                bar.className = 'progress-bar bg-danger';
                text.className = 'badge bg-danger';
                text.innerText = 'Yếu';
            } else if (score < 80) {
                bar.style.width = '66%';
                bar.className = 'progress-bar bg-warning';
                text.className = 'badge bg-warning text-dark';
                text.innerText = 'Trung bình';
            } else {
                bar.style.width = '100%';
                bar.className = 'progress-bar bg-success';
                text.className = 'badge bg-success';
                text.innerText = 'Mạnh (Đạt BRS)';
            }
        }

        function validateAdminChangePassword(e) {
            const newPass = document.getElementById('adminNewPassword')?.value || '';
            const confirmPass = document.getElementById('adminConfirmPassword')?.value || '';
            const alertBox = document.getElementById('adminPassAlert');
            const alertMsg = document.getElementById('adminPassAlertMsg');

            if (newPass.startsWith(' ') || newPass.endsWith(' ')) {
                e.preventDefault();
                alertMsg.innerText = 'Mật khẩu không được chứa khoảng trắng ở đầu hoặc cuối chuỗi!';
                alertBox.classList.remove('d-none');
                return false;
            }

            if (newPass.length < 8 || newPass.length > 64) {
                e.preventDefault();
                alertMsg.innerText = 'Mật khẩu phải có độ dài từ 8 đến 64 ký tự theo chuẩn BRS!';
                alertBox.classList.remove('d-none');
                return false;
            }

            if (newPass !== confirmPass) {
                e.preventDefault();
                alertMsg.innerText = 'Mật khẩu xác nhận không khớp với mật khẩu mới!';
                alertBox.classList.remove('d-none');
                return false;
            }

            let groups = 0;
            if (/[A-Z]/.test(newPass)) groups++;
            if (/[a-z]/.test(newPass)) groups++;
            if (/[0-9]/.test(newPass)) groups++;
            if (/[!@@#$%^&*()_+\-=\[\]{}|;:,.<>?]/.test(newPass)) groups++;

            if (groups < 3) {
                e.preventDefault();
                alertMsg.innerText = 'Mật khẩu phải bao gồm ít nhất 3 trong 4 nhóm: Chữ hoa, chữ thường, chữ số và ký tự đặc biệt!';
                alertBox.classList.remove('d-none');
                return false;
            }

            return true;
        }
    <script>
        // Shortcut ⌘ K / Ctrl + K for quick search
        document.addEventListener('keydown', function (e) {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                const searchInput = document.getElementById('adminQuickSearch');
                if (searchInput) {
                    searchInput.focus();
                    searchInput.select();
                }
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

