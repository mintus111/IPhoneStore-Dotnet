@model List<CartItem>
@{
    var total = (decimal)(ViewBag.TotalAmount ?? 0m);
    ViewData["Title"] = "Giỏ Hàng Của Bạn - BomChelsea";
    bool isInternalStaff = User.Identity != null && User.Identity.IsAuthenticated &&
        (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff") || User.IsInRole("Cashier") || User.IsInRole("Shipper")) &&
        !User.IsInRole("Customer");
}

<div class="container py-4">
    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-danger py-3 px-4 rounded-3 mb-4 shadow-sm border-danger d-flex align-items-center gap-2">
            <span class="fs-5">⚠️</span>
            <div>@TempData["CartError"]</div>
        </div>
    }

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none small">Trang chủ</a></li>
                    <li class="breadcrumb-item active small text-dark fw-semibold" aria-current="page">Giỏ hàng</li>
                </ol>
            </nav>
            <h1 class="fs-3 fw-bold text-dark mb-0">Giỏ Hàng Apple BomChelsea</h1>
        </div>
        <a asp-controller="Home" asp-action="Index" class="text-primary text-decoration-none small fw-semibold">
            ‹ Mua thêm iPhone khác
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-white border rounded-3 text-center py-5 shadow-sm max-w-lg mx-auto" style="max-width: 600px;">
            <div class="text-secondary mb-3">
                <svg width="64" height="64" fill="none" stroke="#86868b" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            </div>
            <h3 class="fw-bold text-dark mb-2">Giỏ hàng của bạn đang trống</h3>
            <p class="text-secondary mb-4">Hãy chọn mua những siêu phẩm iPhone chính hãng mới nhất ngay nhé.</p>
            <a asp-controller="Home" asp-action="Index" class="apple-cta-primary">Khám phá iPhone 16 Series</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left: Cart Items Table -->
            <div class="col-lg-8">
                <div class="bg-white border rounded-3 overflow-hidden shadow-sm">
                    <div class="p-3 border-bottom d-flex align-items-center justify-content-between">
                        <h2 class="fs-5 fw-bold text-dark mb-0">Giỏ hàng của bạn (@Model.Sum(c => c.Quantity) sản phẩm)</h2>
                        <form method="post" asp-controller="Cart" asp-action="Clear">
                            <button type="submit" class="btn btn-link text-danger text-decoration-none small p-0">Xoá toàn bộ</button>
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light text-secondary small text-uppercase">
                                <tr>
                                    <th class="ps-3 py-3">Sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th style="width: 140px;">Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th class="pe-3 text-end">Xoá</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-3 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://store.storeimages.cdn-apple.com/4982/as-images.apple.com/is/iphone-16-pro-finish-select-202409-6-9inch-deserttitanium?wid=940&hei=1112&fmt=png-alpha" : item.ImageUrl)"
                                                     alt="@item.ProductName"
                                                     style="width: 58px; height: 58px; object-fit: contain;" />
                                                <div>
                                                    <a asp-controller="Home" asp-action="Detail" asp-route-id="@item.ProductId" class="text-dark fw-bold text-decoration-none d-block">
                                                        @item.ProductName
                                                    </a>
                                                    <span class="badge bg-light text-secondary border small">@item.Color · @item.Storage · VN/A</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-secondary fw-medium">@item.Price.ToString("N0") ₫</td>
                                        <td>
                                            <form method="post" asp-controller="Cart" asp-action="Update" class="d-flex align-items-center">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <div class="qty-stepper">
                                                    <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="qty-btn">-</button>
                                                    <input type="text" value="@item.Quantity" readonly class="qty-val" />
                                                    <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="qty-btn">+</button>
                                                </div>
                                            </form>
                                        </td>
                                        <td class="fw-bold text-primary">@item.TotalPrice.ToString("N0") ₫</td>
                                        <td class="pe-3 text-end">
                                            <form method="post" asp-controller="Cart" asp-action="Remove">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-link text-danger p-0" title="Xoá khỏi giỏ">
                                                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Coupon Input & Continue shopping -->
                    <div class="p-3 bg-light border-top d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <input type="text" placeholder="Nhập mã giảm giá..." class="form-control form-control-sm rounded-pill px-3" style="max-width: 200px;" />
                            <button type="button" class="btn btn-dark btn-sm rounded-pill px-3">Áp dụng</button>
                        </div>
                        <a asp-controller="Home" asp-action="Index" class="text-primary text-decoration-none small fw-semibold">
                            ‹ Tiếp tục xem thêm sản phẩm
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right: Order Summary Card -->
            <div class="col-lg-4">
                <div class="bg-white border rounded-3 p-4 shadow-sm position-sticky" style="top: 80px;">
                    <h3 class="fs-5 fw-bold text-dark mb-3">Tóm Tắt Đơn Hàng</h3>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-secondary">Tạm tính:</span>
                        <span class="fw-semibold text-dark">@total.ToString("N0") ₫</span>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-secondary">Giảm giá khuyến mãi:</span>
                        <span class="text-success fw-semibold">0 ₫</span>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-secondary">Phí vận chuyển:</span>
                        <span class="text-success fw-bold">⚡ MIỄN PHÍ 2H</span>
                    </div>

                    <div class="d-flex justify-content-between py-3 my-2">
                        <span class="fs-5 fw-bold text-dark">Tổng thanh toán:</span>
                        <div class="text-end">
                            <span class="fs-4 fw-bold text-primary">@total.ToString("N0") ₫</span>
                            <div class="text-secondary small">(Đã bao gồm VAT &amp; Phí bảo hành)</div>
                        </div>
                    </div>

                    <!-- Checkout Button -->
                    @if (isInternalStaff)
                    {
                        <div class="alert alert-warning p-3 rounded-3 mb-3 border-warning">
                            <div class="fw-bold text-dark mb-1">⚠️ Tài khoản Quản trị / Nội bộ (@User.Identity.Name)</div>
                            <div class="small text-secondary mb-3">Tài khoản nội bộ không được phép mua hàng theo quy chuẩn AAR. Vui lòng đăng xuất để dùng tài khoản Khách hàng (ví dụ: nguyenvana).</div>
                            <a asp-controller="Account" asp-action="Logout" asp-route-returnUrl="/Cart" class="btn btn-warning w-100 py-2 fw-semibold rounded-pill text-dark">
                                Đăng xuất để mua hàng &rarr;
                            </a>
                        </div>
                    }
                    else if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Cart" asp-action="Checkout" class="apple-cta-primary w-100 py-3 fs-6 text-center">
                            Tiến hành thanh toán (Bước 3) &rarr;
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Checkout", "Cart")" class="apple-cta-primary w-100 py-3 fs-6 text-center">
                            Đăng nhập để đặt hàng &rarr;
                        </a>
                    }

                    <!-- Notice Callout -->
                    <div class="p-3 bg-light rounded-3 mt-4 border">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <svg width="18" height="18" fill="none" stroke="#0071e3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span class="fw-bold small text-dark">Quyền lợi khách hàng</span>
                        </div>
                        <p class="text-secondary small mb-0">
                            Khách hàng đăng nhập được tích điểm thành viên, theo dõi lịch trình đơn hàng theo thời gian thực và kích hoạt bảo hành điện tử chính hãng tự động.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

